  "risks": [
    {
      "title": "Cyclicité de l'industrie des semi-conducteurs",
      "category": "Industriel",
      "severity": 5,
      "score_rationale": "Risque placé en tête de l'Item 1A du 10-K, langage fort sur les cycles de demande, surcapacités et fluctuations de prix. ADI très exposée aux marchés industriels et automobiles, eux-mêmes cycliques. Pondération Industriel élevée pour semi.",
      "trend": "stable",
      "summary": "Le secteur des semi-conducteurs connaît des cycles marqués de surcapacité et de baisse de demande pouvant affecter durablement les revenus et marges d'ADI.",
      "score": 4
    },
    {
      "title": "Dépendance à la fabrication externalisée (fonderies)",
      "category": "Industriel",
      "severity": 4,
      "score_rationale": "Le 10-K mentionne l'externalisation croissante chez TSMC et autres fonderies asiatiques. Concentration géographique à Taïwan. Risque sous-jacent fort en cas de tensions géopolitiques ou catastrophe naturelle.",
      "trend": "up",
      "summary": "ADI dépend de fonderies tierces situées principalement en Asie, exposant la société à des ruptures d'approvisionnement et à des risques géopolitiques.",
      "score": 3
    },
    {
      "title": "Tensions commerciales et restrictions à l'export Chine",
      "category": "Géopolitique",
      "severity": 5,
      "score_rationale": "Les restrictions US sur l'export de semi-conducteurs vers la Chine sont explicitement citées. La Chine représente une part significative du chiffre d'affaires. Risque actif et croissant en 2025-2026.",
      "trend": "up",
      "summary": "Les contrôles à l'exportation américains vers la Chine peuvent réduire l'accès d'ADI à un marché majeur et perturber ses chaînes de distribution.",
      "score": 4
    },
    {
      "title": "Concurrence intense et pression sur les prix",
      "category": "Concurrence",
      "severity": 4,
      "score_rationale": "Le 10-K cite TI, Infineon, NXP, ST Micro comme concurrents directs. Pression sur les marges via innovation et baisse de prix. Risque structurel récurrent.",
      "trend": "stable",
      "summary": "La concurrence sur les marchés analogiques et signal-mixed exerce une pression continue sur les prix et oblige ADI à investir lourdement en R&D.",
      "score": 3
    },
    {
      "title": "Intégration des acquisitions (Maxim, Linear)",
