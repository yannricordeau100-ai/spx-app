  "risks": [
    {
      "title": "Cyclicité du marché de l'acier et volatilité des prix",
      "category": "Marché",
      "severity": 5,
      "score_rationale": "Le 10-K de Nucor place la cyclicité de l'industrie de l'acier comme risque structurel majeur. Les prix de l'acier ont varié fortement en 2023-2024, impactant directement les marges. La nature cyclique du secteur est explicitement décrite comme un risque persistant avec impact direct sur la rentabilité. Pondération Marché élevée pour un producteur d'acier.",
      "trend": "up",
      "summary": "Nucor est exposée à de fortes variations des prix de l'acier liées à la cyclicité du marché, ce qui peut réduire significativement ses marges et résultats.",
      "score": 3
    },
    {
      "title": "Importations d'acier à bas prix et pratiques commerciales déloyales",
      "category": "Concurrence",
      "severity": 5,
      "score_rationale": "Le document décrit en détail le risque d'importations subventionnées ou dumpées, particulièrement depuis l'Asie. Nucor mentionne explicitement les pratiques déloyales comme menace majeure pour son business model. Le risque est aggravé par les tensions commerciales actuelles et l'incertitude sur les politiques tarifaires américaines.",
      "trend": "up",
      "summary": "L'arrivée d'acier importé à bas prix, parfois subventionné, menace les parts de marché et les prix de vente de Nucor sur le marché américain.",
      "score": 3
    },
    {
      "title": "Volatilité des coûts des matières premières et de l'énergie",
      "category": "Industriel",
      "severity": 4,
      "score_rationale": "La ferraille, l'énergie électrique et le gaz naturel représentent une part majeure des coûts. Nucor souligne la difficulté de répercuter ces hausses sur les clients. La dépendance aux mini-mills électriques expose particulièrement à la volatilité énergétique. Risque amplifié par les tensions sur les marchés énergétiques mondiaux.",
      "trend": "stable",
      "summary": "Les variations des prix de la ferraille et de l'énergie pèsent sur les coûts de production de Nucor, qui ne peut pas toujours les répercuter sur ses clients.",
      "score": 3
    },
    {
      "title": "Risques environnementaux et réglementation climatique",
      "category": "Régulation",
      "severity": 4,
      "score_rationale": "Le 10-K développe les obligations de conformité environnementale et les coûts associés à la décarbonation. La production d'acier est intensive en CO2, exposant Nucor aux futures taxes carbone et réglementations strictes. Les investissements en technologies bas-carbone sont massifs et risqués.",
      "trend": "up",
      "summary": "Les exigences environnementales croissantes imposent à Nucor des investissements importants et des coûts de conformité qui pèsent sur ses résultats.",
      "score": 3
    },
    {
      "title": "Concurrence sur les marchés finaux (construction, automobile)",
      "category": "Concurrence",
      "severity": 4,
      "score_rationale": "Nucor dépend de marchés cycliques comme la construction non résidentielle et l'automobile. Un ralentissement dans ces secteurs impacte directement la demande. La concurrence d'autres aciéristes américains (Steel Dynamics, US Steel, Cleveland-Cliffs) est intense. Langage clair sur la dépendance aux marchés finaux.",
      "trend": "stable",
      "summary": "La demande pour les produits Nucor dépend fortement des cycles de la construction et de l'automobile, secteurs sensibles aux taux d'intérêt et à l'économie.",
      "score": 3
    }
  ],
