 "tagline_fr": "Leader mondial des infrastructures de t\u00e9l\u00e9communications partag\u00e9es.",
 "events_fr": [
  {
   "date": "2026-05-13",
   "title_fr": "L'ETF immobilier XLRE offre des dividendes r\u00e9guliers avec une r\u00e9serve majeure",
   "description_fr": "Le Real Estate Select Sector SPDR Fund (NYSEARCA:XLRE) cote autour de 45 $ avec environ 7,71 milliards d'actifs et un rendement de distribution de 3,4 %."
  },
  {
   "date": "2026-05-08",
   "title_fr": "R\u00e9action des investisseurs aux pr\u00e9visions 2026 relev\u00e9es et au rachat finalis\u00e9 d'American Tower",
   "description_fr": "Fin avril 2026, American Tower publie un T1 avec chiffre d'affaires et r\u00e9sultat net en hausse sur un an et a finalis\u00e9 un rachat d'actions de 567,55 M$ lanc\u00e9 en 2017."
  },
  {
   "date": "2026-05-05",
   "title_fr": "Les analystes rel\u00e8vent l'objectif de cours d'American Tower apr\u00e8s un T1 sup\u00e9rieur aux attentes",
   "description_fr": "American Tower Corporation (NYSE:AMT) figure parmi les meilleures REIT d'infrastructure num\u00e9rique \u00e0 acheter. Raymond James a relev\u00e9 son objectif de 229 \u00e0 240 $."
  }
 ],
 "kpis_explanation_fr": {
  "Property Operations Revenue": "Revenu g\u00e9n\u00e9r\u00e9 par la location d'espaces sur les sites de communication aux op\u00e9rateurs sans fil, radiodiffuseurs et autres locataires.",
  "Number of Communications Sites": "Nombre total de sites de communication d\u00e9tenus ou exploit\u00e9s dans le monde.",
  "Data Center Space": "Surface totale nette louable des centres de donn\u00e9es op\u00e9rationnels aux \u00c9tats-Unis."
 },
 "risks_rationale_fr": {
  "0": "Forte baisse de la demande de leasing impacterait mat\u00e9riellement l'activit\u00e9. Risque tir\u00e9 par d\u00e9cisions capex op\u00e9rateurs, consolidation, conditions \u00e9conomiques, IA et RAN sharing.",
  "1": "Litiges avec clients majeurs (AT&T Mexico ~300M$ annuel, DISH ~2% des revenus) pr\u00e9sentent risques financiers et op\u00e9rationnels mat\u00e9riels avec impact possible sur r\u00e9sultats.",
  "2": "Forte d\u00e9pendance aux op\u00e9rateurs t\u00e9l\u00e9coms cr\u00e9e un risque de concentration. La perte d'un client majeur aurait un impact n\u00e9gatif mat\u00e9riel sur revenus et activit\u00e9.",
  "3": "Concurrence croissante en infrastructures t\u00e9l\u00e9coms pourrait peser sur les loyers, marges et r\u00e9tention, notamment via fournisseurs alternatifs et arrangements de partage de r\u00e9seau.",
  "4": "Technologies \u00e9mergentes (IA, satellite, RAN sharing, \u00e9quipements wireless) pourraient r\u00e9duire la demande pour les tours traditionnelles et acc\u00e9l\u00e9rer l'obsolescence.",
  "5": "Cessions r\u00e9centes (Afrique du Sud Fiber 2025, ATC TIPL 2024) cr\u00e9ent risque d'ex\u00e9cution et de r\u00e9alisation de valeur, impact actuellement limit\u00e9.",
  "6": "\u00c9volutions r\u00e9glementaires (zoning, environnement, licences spectre, fiscalit\u00e9, REIT) pourraient accro\u00eetre co\u00fbts op\u00e9rationnels et limiter l'expansion."
 },
 "stories_body_fr": [
  {
   "kpi_short": "Churn Rate",
   "body_fr": "Revenus perdus suite aux annulations de baux, non-renouvellements ou ren\u00e9gociations de loyers, exprim\u00e9s en pourcentage de la facturation totale aux locataires."
  }
 ],
 "ai_positioning_fr": {
  "summary_fr": "American Tower Corporation reconna\u00eet l'intelligence artificielle et les \u00e9volutions technologiques comme facteurs de risque \u00e9mergents susceptibles d'influencer la demande des clients pour les infrastructures de communication et les strat\u00e9gies de d\u00e9ploiement de r\u00e9seau. L'IA est mentionn\u00e9e dans le contexte des risques de perturbation technologique, y compris les changements potentiels des \u00e9quipements sans fil, l'adoption du partage RAN et les sch\u00e9mas de d\u00e9ploiement de r\u00e9seau.",
  "evidence_fr": [
   {
    "text_fr": "Les facteurs qui influencent la demande de leasing comprennent 'les \u00e9volutions technologiques, dont l'intelligence artificielle (IA), les changements d'\u00e9quipements sans fil, la technologie satellite et une hausse de l'utilisation du partage du r\u00e9seau d'acc\u00e8s radio (RAN) parmi les fournisseurs de services sans fil'",
    "source": "Factors affecting leasing demand include 'technological changes, including artificial intelligence (AI), wireless equipment changes, satellite technology and an increase in the use of radio access network (RAN) sharing among wireless service providers'"
   }
  ],
  "_translated_at": "2026-05-28T16:47:52",
  "_source": "scripts/translate-ai-positioning-fr.py"
 },
