    {
      "title": "Concentration carrier customers (T-Mobile, AT&T, Verizon, DISH)",
      "category": "strategic",
      "severity": 5,
      "score_rationale": "Top 4 carriers US = ~70-75% du revenu site leasing. T-Mobile post-Sprint = ~30% seul. Toute consolidation ou renégociation pèse massivement. Item 1A explicite.",
      "trend": "stable",
      "summary": "La concentration sur 4 carriers US (T-Mobile, AT&T, Verizon, DISH) crée une dépendance critique aux renégociations bail."
    },
    {
      "title": "Consolidation marché tours et décommissioning post-merger",
      "category": "strategic",
      "severity": 5,
      "score_rationale": "Sprint/T-Mobile merger a généré attrition sites historiques significative. Cas similaire DISH-EchoStar à venir. Pression revenu organique.",
      "trend": "up",
      "summary": "Les fusions de carriers (Sprint/T-Mobile, EchoStar/DISH) déclenchent du décommissioning de sites et pèsent sur la croissance organique."
    },
    {
      "title": "Hausse taux d'intérêt et impact REIT valuation + refinancement",
      "category": "financial",
      "severity": 4,
      "score_rationale": "REIT modèle = dette élevée (~$13 Mds). Hausse taux SOFR/Treasury impacte charges financières et cap rates secteur tower.",
      "trend": "stable",
      "summary": "Le modèle REIT à fort levier est très sensible à la hausse des taux d'intérêt sur charges financières et valorisations."
    },
    {
      "title": "Exposition Brésil/Amérique latine et risque FX",
      "category": "financial",
      "severity": 4,
      "score_rationale": "Brésil ~10-15% sites. Real volatile vs USD. Inflation argentine et politiques régulatoires LatAm créent volatilité.",
      "trend": "stable",
      "summary": "L'exposition Brésil et Amérique latine génère une volatilité FX et politique sur une part significative du portefeuille."
    },
    {
      "title": "Transition 5G : densification ou small cells substituts",
      "category": "technological",
      "severity": 3,
      "score_rationale": "5G densification favorise tours macro mais small cells fiber-fed et DAS représentent menace long-terme sur macro towers traditionnelles.",
      "trend": "up",
      "summary": "La 5G favorise les tours macro mais les small cells et le DAS représentent une menace de substitution long-terme."
    },
    {
      "title": "Cybersécurité sur infrastructure télécoms critiques",
      "category": "technological",
      "severity": 3,
      "score_rationale": "Sites tours = infrastructure critique. Attaques sur systèmes monitoring et accès distants en hausse. Item 1A le mentionne.",
      "trend": "up",
      "summary": "Les sites tour critiques exposent SBAC à des cyberattaques sur les systèmes de monitoring et d'accès."
    }
  ],
