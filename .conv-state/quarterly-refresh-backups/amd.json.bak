 "_risks_gov_fetched_at": "2026-05-06T20:27:41.794341+00:00",
 "ai_positioning": {
  "stance": "leader",
  "summary": "AMD est un leader pure-play de l'IA, challenger direct de Nvidia sur les acc\u00e9l\u00e9rateurs data center avec la gamme Instinct MI300X/MI325X/MI350 et les processeurs Ryzen AI pour PC. Le segment Data Center est devenu le premier moteur de croissance gr\u00e2ce \u00e0 la demande IA hyperscale (Microsoft, Meta, Oracle clients confirm\u00e9s).",
  "evidence": [
   {
    "text": "AMD Instinct MI350X Series GPUs d\u00e9ploy\u00e9s par les hyperscalers en 2025, avec roadmap annuelle de leadership pour les solutions AMD Instinct",
    "source": "10-K FY2026"
   },
   {
    "text": "Lancement de la 5\u00e8me g\u00e9n\u00e9ration AMD EPYC family en 2025 offrant leadership performance pour les workloads data center incluant l'IA",
    "source": "10-K FY2026"
   },
   {
    "text": "Expansion du portefeuille data center avec solutions networking IA : AMD Pensando Pollara 400 AI NICs et Vulcano AI NICs pour connectivit\u00e9 haute-vitesse GPU clusters",
    "source": "10-K FY2026"
   },
   {
    "text": "Plateforme Helios AI rack-scale int\u00e9grant CPUs, GPUs et Networking pour adresser les besoins croissants de compute IA",
    "source": "10-K FY2026"
   },
   {
    "text": "Accord de 6 gigawatts avec OpenAI pour d\u00e9ployer AMD Instinct MI450 series GPUs, avec d\u00e9ploiement du premier gigawatt en cours",
    "source": "10-K FY2026"
   },
   {
    "text": "Acquisitions strat\u00e9giques (ZT Systems pour $3.2B) pour avancer les capabilities logicielles en compiler, machine learning, inference et optimisation de performance IA",
    "source": "10-K FY2026"
   }
  ],
  "source": "10-K FY2026",
