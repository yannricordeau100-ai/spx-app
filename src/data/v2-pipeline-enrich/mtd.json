  "risks": [
    {
      "title": "Ralentissement économique dans les pays développés",
      "category": "macro",
      "severity": 4,
      "trend": "up",
      "summary": "Une récession ou une croissance lente dans les économies développées réduit la demande des clients de MTD, entraîne des retards de dépenses d'investissement, des difficultés de financement et augmente les créances irrécouvrables, affectant les revenus et la rentabilité."
    },
    {
      "title": "Concentration des activités en Chine et tensions géopolitiques",
      "category": "operational",
      "severity": 4,
      "trend": "up",
      "summary": "Les ventes, la production et les bénéfices de MTD dépendent fortement de la Chine (16 % des ventes, 30 % de la production). Les tensions commerciales USA Chine, les restrictions d’exportation et les exigences de rapatriement des devises peuvent réduire les ventes et augmenter les coûts."
    },
    {
      "title": "Risque de cybersécurité et d’interruption des systèmes informatiques",
      "category": "cyber",
      "severity": 5,
      "trend": "stable",
      "summary": "Une attaque informatique, un ransomware ou une défaillance du système ERP Blue Ocean pourrait interrompre les ventes, la facturation et la production de MTD, entraîner la perte de données sensibles et générer des coûts de remédiation et des dommages réputationnels."
    },
    {
      "title": "Conformité aux sanctions économiques et aux contrôles à l’exportation",
      "category": "regulatory",
      "severity": 4,
      "trend": "new",
      "summary": "Les lois américaines, européennes et locales imposent des licences d’exportation et des sanctions contre la Russie et d’autres pays. Le non respect expose MTD à des amendes, des restrictions commerciales et à des atteintes à la réputation."
    },
    {
      "title": "Dépendance aux fournisseurs uniques et risques de chaîne d’approvisionnement",
      "category": "operational",
      "severity": 4,
      "trend": "up",
      "summary": "Une partie des matières premières et composants de MTD provient d’un nombre limité de fournisseurs. Toute interruption due à des grèves, des catastrophes naturelles ou des restrictions commerciales pourrait retarder la production et entraîner des pertes de ventes."
    }
  ],
