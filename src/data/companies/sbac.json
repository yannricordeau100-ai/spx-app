      "en": {
        "activity": "SBA Communications builds and manages towers for mobile phone companies.",
        "products": "It provides space on its towers for operator antennas.",
        "customers": "Its clients are major telecommunications companies that need to install their equipment.",
        "edge": "SBA owns an extensive network of towers essential for mobile networks to function."
      },
      "de": {
        "activity": "SBA Communications baut und verwaltet Mobilfunkmasten für Mobilfunkunternehmen.",
        "products": "Es stellt Platz auf seinen Türmen für Antennen von Betreibern bereit.",
        "customers": "Seine Kunden sind große Telekommunikationsunternehmen, die ihre Ausrüstung installieren müssen.",
        "edge": "SBA besitzt ein weitläufiges Netz von Türmen, die für den Betrieb von Mobilfunknetzen unerlässlich sind."
      }
    },
    "advanced": {
      "fr": {
        "positioning": "SBA Communications est un opérateur indépendant d'infrastructure de communication sans fil (tours), se positionnant entre les fournisseurs de réseaux mobiles et les fabricants d'équipements. Elle est concurrencée par American Tower et Crown Castle.",
        "tech_products": "L'entreprise propose des sites d'hébergement pour les antennes 4G/5G, des solutions d'ajout d'antennes (colocation) et des contrats de location de longue durée pour les infrastructures de réseaux.",
        "moat": "Son avantage réside dans son portefeuille dense de tours stratégiquement situées, créant des barrières à l'entrée et des coûts de changement élevés pour les opérateurs qui dépendent de son réseau pour leur couverture.",
        "risks": "La dépendance à l'égard des dépenses d'investissement des grands opérateurs télécoms et le risque de consolidation du secteur sont des faiblesses notables."
      },
      "en": {
        "positioning": "SBA Communications is an independent wireless communication infrastructure (tower) operator, positioned between mobile network providers and equipment manufacturers. It competes with American Tower and Crown Castle.",
        "tech_products": "The company offers hosting sites for 4G/5G antennas, antenna co-location solutions, and long-term infrastructure leasing agreements for networks.",
        "moat": "Its advantage lies in its dense portfolio of strategically located towers, creating barriers to entry and high switching costs for operators relying on its network for coverage.",
        "risks": "Reliance on the capital expenditures of major telecom carriers and the risk of industry consolidation are notable weaknesses."
      },
      "de": {
        "positioning": "SBA Communications ist ein unabhängiger Betreiber von drahtlosen Kommunikationsinfrastrukturen (Türmen) und positioniert sich zwischen Mobilfunknetzbetreibern und Ausrüstungsherstellern. Es konkurriert mit American Tower und Crown Castle.",
        "tech_products": "Das Unternehmen bietet Hosting-Standorte für 4G/5G-Antennen, Colocation-Lösungen für Antennen und langfristige Mietverträge für Netzinfrastrukturen an.",
        "moat": "Sein Vorteil liegt in seinem dichten Portfolio strategisch günstig gelegener Türme, die Eintrittsbarrieren und hohe Wechselkosten für Betreiber schaffen, die für ihre Abdeckung auf sein Netzwerk angewiesen sind.",
        "risks": "Die Abhängigkeit von den Investitionsausgaben großer Telekommunikationsanbieter und das Risiko der Branchenkonsolidierung sind bemerkenswerte Schwächen."
      }
