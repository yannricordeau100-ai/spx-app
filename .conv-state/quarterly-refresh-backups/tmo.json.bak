 "risks": [
  {
   "title": "Ralentissement ou cyclicité des marchés servis",
   "category": "Marché",
   "severity": 5,
   "score_rationale": "Tout premier facteur de l'Item 1A (position maximale), langage affirmatif ('would diminish demand', 'would adversely affect our financial statements'). Poids catégoriel fort : la croissance de Thermo Fisher dépend directement de celle des marchés pharma, biotech et recherche, avec des cycles baissiers explicitement cités.",
   "trend": "stable",
   "summary": "La croissance de Thermo Fisher dépend de celle des marchés servis : pharma, biotech, diagnostics, recherche académique. Un ralentissement ou un cycle baissier de ces marchés réduirait mécaniquement la demande pour ses produits et services.",
   "score": 5
  },
  {
   "title": "Exposition internationale : tarifs, Chine et devises",
   "category": "Géopolitique",
   "severity": 4,
   "score_rationale": "Troisième facteur de l'Item 1A (position haute), avec liste explicite : tarifs US et contre-mesures, réglementations chinoises favorisant les fournisseurs locaux, sanctions et volatilité des changes. Tendance en hausse liée aux politiques tarifaires changeantes, poids catégoriel géopolitique pondéré fort.",
   "trend": "up",
   "summary": "Une part substantielle des revenus vient de l'international. Tarifs douaniers et contre-mesures, réglementations chinoises poussant aux fournisseurs locaux et fluctuations de change (effet devise de +0,37 Md$ sur les revenus 2025) exposent les résultats.",
   "score": 4
  },
  {
   "title": "Dépendance aux budgets publics et au capex des clients",
   "category": "Marché",
   "severity": 4,
   "score_rationale": "Quatrième facteur de l'Item 1A (position haute), tendance en hausse : le 10-K cite le shutdown fédéral américain d'octobre 2025 faute de budget voté. Langage direct ('substantial delays or reductions in federal spending'), poids notable car universités, agences publiques et instituts de recherche sont des clients majeurs.",
   "trend": "up",
   "summary": "Les achats des clients publics et académiques dépendent des budgets votés. Le 10-K cite le shutdown fédéral US d'octobre 2025 : une impasse budgétaire similaire retarderait ou réduirait substantiellement les dépenses fédérales adressables.",
   "score": 4
  },
  {
   "title": "Cyberattaque majeure sur les systèmes d'information",
   "category": "Cyber",
   "severity": 4,
   "score_rationale": "Facteur situé au milieu de l'Item 1A (Operational Risks) mais avec le langage le plus intensif de la section ('materially harm our business') et l'aveu d'attaques subies régulièrement ('on a regular basis'). Poids catégoriel cyber pondéré fort, amplifié par les données médicales et personnelles traitées.",
   "trend": "stable",
   "summary": "Thermo Fisher traite des données sensibles (médicales, financières, personnelles) et reconnaît subir régulièrement des tentatives d'intrusion. Une cyberattaque majeure pourrait interrompre les opérations, retarder les livraisons et engager sa responsabilité.",
   "score": 4
  },
  {
   "title": "Intégration des acquisitions et goodwill de 49,4 Mds $",
   "category": "Industriel",
   "severity": 3,
   "score_rationale": "Facteur en fin de section Business Risks (position médiane de l'Item 1A), langage conditionnel ('could adversely affect'). Poids significatif au bilan : 49,36 Mds $ de goodwill et 15,8 Mds $ d'incorporels au 31 décembre 2025, dont la valeur dépend de la réussite des intégrations ; tendance stable vs N-1.",
   "trend": "stable",
   "summary": "La stratégie repose sur des acquisitions payées avec prime. Au 31 décembre 2025, le bilan porte 49,36 Mds $ de goodwill et plus de 15 Mds $ d'incorporels : une intégration ratée ou des cash-flows décevants imposeraient des charges de dépréciation matérielles.",
   "score": 3
  },
  {
   "title": "Fournisseurs en source unique et ruptures d'approvisionnement",
   "category": "Opérationnel",
   "severity": 3,
   "score_rationale": "Premier facteur de la section Operational Risks (milieu de l'Item 1A), langage neutre ('could cause production interruptions, delays and inefficiencies'). Tendance stable, poids catégoriel moyen : dépendance à des fournisseurs en source unique ou limitée pour certains matériaux critiques.",
   "trend": "stable",
   "summary": "Certains matériaux et composants proviennent de fournisseurs uniques ou limités pour des raisons de qualité ou d'exigences réglementaires. Une défaillance de ces fournisseurs entraînerait interruptions de production, délais allongés et pertes d'efficacité.",
   "score": 3
