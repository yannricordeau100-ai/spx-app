 "risks": [
  {
   "title": "Volatilit\u00e9 des co\u00fbts \u00e9nerg\u00e9tiques et mati\u00e8res premi\u00e8res",
   "category": "Mati\u00e8res premi\u00e8res",
   "severity": 3,
   "score_rationale": "Le 10-K FY2025 indique \"Energy, including electricity, natural gas, and diesel fuel\" comme \"the largest cost component of our business\", passage situe au milieu de l'Item 1A. Exposition concrete (intrant principal) mais langage modere (\"could result in lost sales or reduced profitability\") et mecanisme de pass-through contractuel attenuant: 3/5.",
   "trend": "up",
   "summary": "Air Products est tr\u00e8s expos\u00e9e aux variations des prix de l'\u00e9lectricit\u00e9 et du gaz naturel, intrants cl\u00e9s de production qui p\u00e8sent directement sur ses marges.",
   "score": 3
  },
  {
   "title": "Ex\u00e9cution des m\u00e9ga-projets hydrog\u00e8ne vert/bleu",
   "category": "Op\u00e9rationnel",
   "severity": 4,
   "score_rationale": "Premier risque de la section Risks Related to Our Business (haut de l'Item 1A). Langage fort: \"could have a material adverse effect on our financial condition and results of operations\" pour les retards et surcouts des grands projets, avec investissement de plusieurs milliards et incertitude offtake hydrogene explicitement developpee: 4/5.",
   "trend": "up",
   "summary": "Les m\u00e9ga-projets hydrog\u00e8ne (NEOM, Louisiana, Alberta) cumulent des risques majeurs d'ex\u00e9cution (surco\u00fbts, retards) et d'incertitude sur la demande finale.",
   "score": 4
  },
  {
   "title": "Cyclicit\u00e9 industrielle et exposition manufacturi\u00e8re",
   "category": "Macro",
   "severity": 3,
   "score_rationale": "Tout premier risque de l'Item 1A (\"Changes in global and regional economic conditions... may adversely affect our results of operations\") mais langage conditionnel standard, sans exposition chiffree alarmante. Position en tete compensee par formulation prudentielle: 3/5.",
   "trend": "stable",
   "summary": "La demande de gaz industriels d'Air Products d\u00e9pend de secteurs cycliques (sid\u00e9rurgie, chimie, semi-conducteurs) sensibles aux ralentissements \u00e9conomiques.",
   "score": 3
  },
  {
   "title": "R\u00e9gulation environnementale et incitations transition \u00e9nerg\u00e9tique",
   "category": "R\u00e9glementaire",
   "severity": 4,
   "score_rationale": "Section Legal and Regulatory Risks (deuxieme moitie de l'Item 1A) mais risque materialise et chiffre: \"we cancelled a project to build a green liquid hydrogen project\" en FY2025 avec \"a significant impairment charge\" lie au credit 45V. Exposition concrete averee: 4/5.",
   "trend": "up",
   "summary": "Les projets hydrog\u00e8ne d'Air Products d\u00e9pendent des cr\u00e9dits d'imp\u00f4t IRA et des subventions transition \u00e9nerg\u00e9tique, expos\u00e9s aux changements politiques.",
   "score": 4
  },
