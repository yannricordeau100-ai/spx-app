 "risks": [
  {
   "title": "Cyclicit\u00e9 des march\u00e9s industriels et a\u00e9rospatial",
   "category": "March\u00e9",
   "severity": 4,
   "trend": "stable",
   "score_rationale": "Tete de l'Item 1A (~1-2%) : \"A number of the industries in which we operate are cyclical in nature\". Position maximale mais langage d'impact simple (could have an adverse effect), sans chiffrage : 4.",
   "summary": "Une part majeure du CA vient d'OEM industriels et a\u00e9rospatiaux expos\u00e9s aux cycles capex. Un retournement simultan\u00e9 ferait chuter le book-to-bill sous 1.",
   "score": 4
  },
  {
   "title": "Ex\u00e9cution de la strat\u00e9gie d'acquisitions",
   "category": "Financier",
   "severity": 2,
   "trend": "stable",
   "score_rationale": "Bas de l'Item 1A (~63%), langage prudentiel : \"may not be able to consummate future acquisitions or successfully integrate\". La ste place ce risque en fin de liste malgre sa strategie M&A : 2.",
   "summary": "La croissance repose sur ~1 Md$ de M&A par an. Toute mauvaise valorisation ou int\u00e9gration rat\u00e9e diluerait la marge et le ROIC qui font la th\u00e8se boursi\u00e8re.",
   "score": 2
  },
  {
   "title": "Cha\u00eene d'approvisionnement composants \u00e9lectroniques",
   "category": "Industriel",
   "severity": 3,
   "trend": "stable",
   "score_rationale": "Milieu de l'Item 1A (~37%), langage conditionnel : \"supply of our components and raw materials may adversely impact our operations\". Pas d'exposition chiffree ni de source unique : 3.",
   "summary": "Les instruments d'analyse et de mesure d\u00e9pendent de composants \u00e9lectroniques sp\u00e9cifiques. Des tensions d'approvisionnement d\u00e9calent les livraisons et amputent la marge sur affaires.",
   "score": 3
  },
  {
   "title": "Concentration d\u00e9fense US et budget f\u00e9d\u00e9ral",
   "category": "G\u00e9opolitique",
   "severity": 3,
   "trend": "up",
   "score_rationale": "Haut de l'Item 1A (~6%) mais langage faible : \"government budget dynamics, as well as product and economic cycles, can affect\" les decisions de depense des clients. Pas de risque defense dedie ni chiffre : 3.",
   "summary": "Les programmes d\u00e9fense am\u00e9ricains portent une part croissante du carnet EMG. Un shutdown ou une r\u00e9affectation budg\u00e9taire d\u00e9calerait plusieurs trimestres de facturation.",
   "score": 3
  },
  {
   "title": "Cybers\u00e9curit\u00e9 et propri\u00e9t\u00e9 intellectuelle",
   "category": "Cyber",
   "severity": 3,
   "trend": "up",
   "score_rationale": "Milieu de l'Item 1A (~51%) : \"adversely impacted by a significant disruption in, or breach in security\". Section cyber developpee, langage standard : 3.",
   "summary": "Les technologies de mesure et calibration sont brevet\u00e9es. Une exfiltration profiterait \u00e0 des concurrents asiatiques et ouvrirait des dossiers ITAR c\u00f4t\u00e9 d\u00e9fense.",
   "score": 3
  },
  {
   "title": "Change et exposition internationale",
   "category": "Financier",
   "severity": 4,
   "trend": "stable",
   "score_rationale": "Haut de l'Item 1A (~10%) avec exposition chiffree : \"International sales for 2025 and 2024 represented 48.2% and 47.4%\". Position haute et moitie du CA exposee : 4.",
   "summary": "Une partie significative du CA vient hors USD (Europe, Chine, ASEAN). Un dollar fort \u00e9rode la croissance publi\u00e9e sans alt\u00e9rer les volumes.",
   "score": 4
  },
  {
   "title": "R\u00e9gulation environnementale et REACH",
   "category": "R\u00e9gulation",
   "severity": 2,
   "trend": "stable",
   "score_rationale": "Fin de l'Item 1A (~74%), langage prudentiel : \"may cause us to be liable for costs associated with hazardous or toxic substance clean-up\". Risque environnemental generique : 2.",
   "summary": "Certains compos\u00e9s utilis\u00e9s en instruments d'analyse sont vis\u00e9s par REACH et TSCA. Les reformulations requises restent g\u00e9rables mais alourdissent le co\u00fbt du portefeuille.",
   "score": 2
  }
 ],
