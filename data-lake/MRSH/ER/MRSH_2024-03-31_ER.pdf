<div class="htmleditor aem-GridColumn aem-GridColumn--default--12">


    <script>
  var body = document.querySelector("body");
  const osanoDrawerHandler = () => {
    const manageCookiesButton = document.querySelector("a[href='#osano-manage-cookies']");
    if (manageCookiesButton) {
      manageCookiesButton.classList.add('osano-manage-cookies--button');
      manageCookiesButton.setAttribute('role', 'button');
      manageCookiesButton.removeAttribute('href');
      manageCookiesButton.addEventListener('click', () => {
        Osano.cm.showDrawer('osano-cm-dom-info-dialog-open');
      });
    }
  };
  var observer = new MutationObserver(osanoDrawerHandler);
  observer.observe(body, {
    subtree: true,
    childList: true,
    characterData: true,
  });
  if (document.readyState !== 'loading') {
    osanoDrawerHandler();
  } else {
    document.addEventListener('DOMContentLoaded', osanoDrawerHandler);
  }
</script>

