  "ai_positioning": {
    "stance": "emerging_risk",
    "summary": "Eversource mentionne les cyberattaques assistées par l'intelligence artificielle comme risque croissant dans son rapport 10-K, mais n'a pas encore d'initiatives publiques majeures de déploiement d'IA dans ses opérations. La société reconnaît que les cybermenaces augmentent en sophistication incluant l'IA, et prévoit d'investir en technologie de l'information dans son plan d'investissement 2026-2030.",
    "evidence": [
      "Cyberattacks that seek to exploit potential vulnerabilities in the utility industry are increasing in sophistication including artificial intelligence",
      "Plan to invest $1.23 billion in information technology and facilities upgrades and enhancements from 2026-2030"
    ],
    "source": "10-K 2025, Item 1A Risk Factors (Cybersecurity Risks) and Item 7 MDA (Capital Expenditures)"
  },
  "risks": [
    {
      "title": "Cyberattaques assistées par l'IA",
      "category": "Cybersécurité",
      "severity": 5,
      "score_rationale": "La société est vulnérable aux cyberattaques sophistiquées incluant l'IA, qui pourraient compromettre les systèmes critiques de transmission et distribution d'électricité, gaz et eau. L'impact potentiel sur les opérations et la réputation est significatif.",
      "trend": "up",
      "summary": "Les cyberattaques augmentent en sophistication, magnitude et fréquence, ciblant les infrastructures critiques. Les conflits géopolitiques accélèrent cette menace."
    },
    {
      "title": "Réglementation et taux autorisés",
      "category": "Régulation",
      "severity": 4,
