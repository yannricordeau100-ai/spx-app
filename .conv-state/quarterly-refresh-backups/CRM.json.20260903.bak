, "_source_month": "mai 2026", "last_data_date": "2026-04-30", "_new_extraction_at": "2026-07-13T00:00:00Z"}], "stories_kpis": [{"short": "Agentforce ARR x2.7", "name_fr": "Agentforce ARR x2.7", "value": 3.4, "unit": "Md $", "description": "L'ARR combine Agentforce et Data 360 atteint pres de 3,4 Md$ au T1 exercice 2027, avec l'ARR Agentforce seul en hausse de 205% sur un an : la monetisation de l'IA agentique passe a l'echelle.", "story_category": "Innovation", "is_short_history": true, "_source": "ER", "_source_month": "mai 2026", "_source_file": null}, {"short": "RPO record 72 Md$", "name_fr": "RPO record 72 Md$", "value": 35.1, "unit": "Md $", "description": "Au T4 exercice 2026, les obligations de performance restantes depassent 72 Md$ (+14% sur un an) et le cRPO bondit de 16%, signe d'une demande contractee solide et en acceleration.", "story_category": "Marché", "is_short_history": true, "_source": "ER", "_source_month": "mai 2026", "_source_file": null}, {"short": "3,8 Md AWU delivres", "name_fr": "3,8 Md AWU delivres", "value": 111, "unit": "%", "description": "Salesforce a delivre 3,8 milliards d'Agentic Work Units a ses clients (+111% sequentiel), une nouvelle metrique mesurant le travail reel accompli par les agents IA sur Agentforce et Slack.", "story_category": "Innovation", "is_short_history": true, "_source": "ER", "_source_month": "mai 2026", "_source_file": null}, {"short": "29 000 deals Agentforce", "name_fr": "29 000 deals Agentforce", "value": 800, "unit": "M $", "description": "Salesforce a signe plus de 29 000 contrats Agentforce depuis le lancement (+50% sequentiel), avec un ARR Agentforce a 800 M$ en hausse de 169% sur un an.", "story_category": "Innovation", "is_short_history": true, "_source": "ER", "_source_month": "mai 2026", "_source_file": null}, {"short": "52 000 Md records ingeres", "name_fr": "52 000 Md records ingeres", "value": 136, "unit": "%", "description": "Data 360 a ingere 52 000 milliards d'enregistrements au T1 exercice 2027 (+136% sur un an), dont 35 000 milliards via Zero Copy (+277%), socle de donnees alimentant les agents IA.", "story_category": "Innovation", "is_short_history": true, "_source": "ER", "_source_month": "mai 2026", "_source_file": null}, {"short": "Agentforce Apps revenue +9%", "name_fr": "Revenu Agentforce Apps +9%", "name_en": "Agentforce Apps revenue +9%", "value": 6910, "unit": "M $", "yoy": "+9,0 %", "type": "quarter", "nature": "financial", "signal": "positive", "description": "Le revenu de la categorie Agentforce Apps (ventes, service, marketing, commerce, Slack) atteint 6,91 Md$ au T1 exercice 2027, en hausse de 9% sur un an et represente 65% du chiffre d'affaires abonnements.", "story_category": "Croissance", "is_short_history": true, "_source": "10-Q Q1 FY2027", "_source_file": "data-lake/CRM/10Q/CRM_2026-05-28.htm.gz", "_source_month": "juillet 2026", "last_data_date": "2026-04-30", "_new_extraction_at": "2026-07-13T09:30:00Z"}, {"short": "Data 360 & Headless Platform revenue +25%", "name_fr": "Revenu Data 360 et plateforme +25%", "name_en": "Data 360 & Headless Platform revenue +25%", "value": 3683, "unit": "M $", "yoy": "+25,0 %", "type": "quarter", "nature": "financial", "signal": "positive", "description": "La categorie Data 360, Headless Platform et Informatica genere 3,68 Md$ au T1 exercice 2027, en croissance de 25% sur un an, le segment le plus dynamique du mix produits.", "story_category": "Croissance", "is_short_history": true, "_source": "10-Q Q1 FY2027", "_source_file": "data-lake/CRM/10Q/CRM_2026-05-28.htm.gz", "_source_month": "juillet 2026", "last_data_date": "2026-04-30", "_new_extraction_at": "2026-07-13T09:30:00Z"}, {"short": "Operating margin ~21%", "name_fr": "Marge operationnelle proche de 21%", "name_en": "Operating margin ~21%", "value": 21, "unit": "%", "yoy": "+1,0 %", "type": "quarter", "nature": "financial", "signal": "positive", "description": "La marge operationnelle (resultat d'exploitation rapporte au chiffre d'affaires total) atteint environ 21% au T1 exercice 2027, contre environ 20% un an plus tot, portee par les initiatives de restructuration.", "story_category": "Croissance", "is_short_history": true, "_source": "10-Q Q1 FY2027", "_source_file": "data-lake/CRM/10Q/CRM_2026-05-28.htm.gz", "_source_month": "juillet 2026", "last_data_date": "2026-04-30", "_new_extraction_at": "2026-07-13T09:30:00Z"}, {"short": "Dividendes verses -9,2%", "name_fr": "Dividendes verses en recul", "name_en": "Dividends paid -9.2%", "value": 365, "unit": "M $", "yoy": "-9,2 %", "type": "quarter", "nature": "financial", "signal": "neutral", "description": "Salesforce a verse environ 365 M$ de dividendes au T1 exercice 2027, contre 402 M$ un an plus tot, une baisse liee a la reduction du nombre d'actions en circulation apres les rachats.", "story_category": "Capacité", "is_short_history": true, "_source": "10-Q Q1 FY2027", "_source_file": "data-lake/CRM/10Q/CRM_2026-05-28.htm.gz", "_source_month": "juillet 2026", "last_data_date": "2026-04-30", "_new_extraction_at": "2026-07-13T09:30:00Z"}], "ai_positioning": {"stance": "leader", "summary": "Salesforce a fait de l'IA sa priorité stratégique avec la plateforme Einstein et le lancement d'Agentforce, sa suite d'agents autonomes intégrée au CRM.", "evidence": [{"title": "Lancement d'Agentforce", "description_fr": "Salesforce a lancé Agentforce en 2024, une plateforme d'agents IA autonomes pour les ventes, le service client et le marketing.", "source_url": "https://www.salesforce.com/news/press-releases/2024/09/12/agentforce-announcement/", "date": "2024-09-12", "text": "Lancement d'Agentforce : Salesforce a lancé Agentforce en 2024, une plateforme d'agents IA autonomes pour les ventes, le service client et le marketing."}, {"title": "Einstein GPT et Data Cloud", "description_fr": "Salesforce intègre l'IA générative Einstein GPT à toute sa suite Customer 360, connectée à Data Cloud pour la personnalisation temps réel.", "source_url": "https://www.salesforce.com/news/press-releases/2023/03/07/einstein-generative-ai/", "date": "2023-03-07", "text": "Einstein GPT et Data Cloud : Salesforce intègre l'IA générative Einstein GPT à toute sa suite Customer 360, connectée à Data Cloud pour la personnalisation temps réel."}], "source": "Communiqués officiels, filings SEC et presse spécialisée"}, "risks": [{"title": "Cybersécurité et violations de données", "category": "Cybersécurité", "severity": 5, "score_rationale": "La société est exposée à des cyberattaques et des failles de sécurité qui pourraient entraîner des pertes de données clients, des dommages à la réputation et des perturbations de service. La nature critique de ses services cloud amplifie l'impact potentiel. Citation: \"Additionally, it may take considerable time for us to investigate and evaluate the full impact\". Position: haut Item 1A.", "trend": "up", "summary": "La société est vulnérable aux cyberattaques et aux failles de sécurité touchant ses systèmes, ceux de ses fournisseurs tiers ou l'infrastructure Internet, ce qui pourrait avoir des conséquences graves sur son activité et sa réputation.", "score": 5}, {"title": "Défaillances techniques et interruptions de service", "category": "Industriel", "severity": 4, "score_rationale": "Les défaillances techniques pourraient entraîner des interruptions de service, impactant la satisfaction client et les revenus dans un modèle SaaS où la disponibilité est essentielle. Citation: \"Our business and reputation would also be harmed if our customers and potential customers perceive\". Position: milieu Item 1A.", "trend": "stable", "summary": "Les défaillances techniques et interruptions de service pourraient avoir un impact négatif sur l'activité de la société et sa réputation auprès des clients.", "score": 4}, {"title": "Dépendance aux fournisseurs tiers", "category": "Industriel", "severity": 4, "score_rationale": "La société dépend de fournisseurs tiers pour les centres de données, les plateformes cloud et d'autres services critiques, ce qui crée des risques d'interruption de service et de perte de contrôle. Citation: \"Our business and reputation would also be harmed if our customers and potential customers perceive\". Position: milieu Item 1A.", "trend": "up", "summary": "La dépendance de la société à l'égard de fournisseurs tiers pour des services critiques pourrait entraîner des risques pour son activité et sa réputation en cas de défaillance de ces partenaires.", "score": 4}, {"title": "Évolution réglementaire et conformité", "category": "Régulation", "severity": 4, "score_rationale": "Les changements réglementaires en matière de protection des données, de confidentialité et d'IA pourraient imposer des coûts de conformité élevés et limiter certaines pratiques commerciales. Citation: \"Additionally, increased energy consumption, including as a result of AI adoption, climate-related events, energy market\". Position: milieu Item 1A.", "trend": "up", "summary": "Les changements réglementaires croissants en matière de protection des données, confidentialité et IA pourraient entraîner des coûts et des complexités supplémentaires pour la société.", "score": 4}, {"title": "Intensification de la concurrence", "category": "Concurrence", "severity": 4, "score_rationale": "La concurrence intense dans le secteur du CRM et du cloud, notamment avec des acteurs majeurs et des nouveaux entrants axés sur l'IA, pourrait entraîner des pertes de parts de marché et une pression sur les prix. Citation: \"In addition, the markets and monetization strategies for certain offerings, including Agentforce and Data 360\". Position: bas Item 1A.", "trend": "stable", "summary": "La concurrence intense dans le secteur du CRM et du cloud computing pourrait avoir un impact négatif sur les parts de marché, les prix et la croissance de la société.", "score": 4}, {"title": "Risques liés aux acquisitions et intégrations", "category": "Capital", "severity": 4, "score_rationale": "Les acquisitions récentes (Informatica, Regrello) présentent des risques d'intégration, de valorisation et de réalisation des synergies attendues, pouvant impacter les résultats financiers. Citation: \"Governments may continue to adopt or tighten restrictions of this nature, some of which may\". Position: milieu Item 1A.", "trend": "up", "summary": "Les risques liés aux acquisitions, notamment l'intégration d'Informatica pour 9,6 milliards de dollars, pourraient avoir un impact négatif sur les résultats financiers si les synergies attendues ne se matérialisent pas.", "score": 4}, {"title": "Perte de personnel clé et attraction de talents", "category": "Personne-clé", "severity": 3, "score_rationale": "La perte de personnel clé, notamment dans un contexte de forte demande pour les talents en IA et technologie, pourrait ralentir l'innovation et l'exécution stratégique. Citation: \"Additionally, our compensation arrangements and benefits may not always be successful in attracting new employees\". Position: bas Item 1A.", "trend": "stable", "summary": "La perte de personnel clé et les difficultés à attirer et retenir des talents technologiques, notamment en IA, pourraient entraver l'exécution de la stratégie de l'entreprise.", "score": 3}], "_validation": [{"champ": "hero_kpi_rationale", "correction": "Amélioration de la formulation pour éviter l'em-dash et ajouter des détails chiffrés (14%, 72,4 Mds $) pour plus de substance", "avant": "particulièrement pertinent pour les entreprises SaaS comme Salesforce. Son augmentation significative montre une forte demande et un engagement client solide.", "apres": "particulièrement pertinent pour les entreprises SaaS comme Salesforce. Son augmentation significative de 14% montre une forte demande et un engagement client solide, avec 72,4 milliards de dollars de revenus futurs contractuels."}, {"champ": "kpis[2].yoy", "correction": "Correction de l'unité pour l'Operating Margin : 'pts' -> 'pt' (singulier car +1.0)", "avant": "+1.0 pts", "apres": "+1.0 pt"}, {"champ": "kpis[3].name_fr", "correction": "Pluriel pour cohérence avec l'anglais et l'usage standard", "avant": "Flux de trésorerie opérationnel", "apres": "Flux de trésorerie opérationnels"}, {"champ": "stories_kpis[0].name_fr", "correction": "Ajout de 'de' pour améliorer la grammaire française", "avant": "Intégration IA dans les produits", "apres": "Intégration de l'IA dans les produits"}, {"champ": "stories_kpis[1].name_fr", "correction": "Ajout de 'd'' pour améliorer la grammaire française", "avant": "Acquisition Informatica", "apres": "Acquisition d'Informatica"}, {"champ": "stories_kpis[2].name_fr", "correction": "Ajout de 'd'' pour améliorer la grammaire française", "avant": "Dynamique Agentforce", "apres": "Dynamique d'Agentforce"}, {"champ": "risks[0].title", "correction": "Amélioration du titre pour être plus précis et refléter le contenu du summary", "avant": "Cybersécurité", "apres": "Cybersécurité et violations de données"}, {"champ": "risks[0].score_rationale", "correction": "Enrichissement de la justification pour mieux expliquer la sévérité de 5", "avant": "La société est exposée à des cyberattaques et des failles de sécurité, ce qui pourrait entraîner des pertes de données et des dommages à la réputation.", "apres": "La société est exposée à des cyberattaques et des failles de sécurité qui pourraient entraîner des pertes de données clients, des dommages à la réputation et des perturbations de service. La nature critique de ses services cloud amplifie l'impact potentiel."}, {"champ": "risks[0].summary", "correction": "Amélioration pour refléter l'étendue des risques mentionnés dans le 10-K (fournisseurs tiers, infrastructure Internet)", "avant": "La société est vulnérable aux cyberattaques et aux failles de sécurité, ce qui pourrait avoir des conséquences graves sur son activité et sa réputation.", "apres": "La société est vulnérable aux cyberattaques et aux failles de sécurité touchant ses systèmes, ceux de ses fournisseurs tiers ou l'infrastructure Internet, ce qui pourrait avoir des conséquences graves sur son activité et sa réputation."}, {"champ": "risks[1].title", "correction": "Titre plus descriptif et précis", "avant": "Défaillances techniques", "apres": "Défaillances techniques et interruptions de service"}, {"champ": "risks[1].score_rationale", "correction": "Enrichissement pour justifier la sévérité dans le contexte SaaS", "avant": "Les défaillances techniques pourraient entraîner des interruptions de service et des pertes de revenus.", "apres": "Les défaillances techniques pourraient entraîner des interruptions de service, impactant la satisfaction client et les revenus dans un modèle SaaS où la disponibilité est essentielle."}, {"champ": "risks[1].summary", "correction": "Amélioration de la formulation pour plus de clarté", "avant": "Les défaillances techniques pourraient avoir un impact négatif sur l'activité de la société et sa réputation.", "apres": "Les défaillances techniques et interruptions de service pourraient avoir un impact négatif sur l'activité de la société et sa réputation auprès des clients."}, {"champ": "risks[2].title", "correction": "Titre plus précis reflétant la nature du risque", "avant": "Dépendance aux tiers", "apres": "Dépendance aux fournisseurs tiers"}, {"champ": "risks[2].score_rationale", "correction": "Enrichissement pour expliquer les types de dépendances critiques", "avant": "La société dépend de tiers pour la fourniture de services et de produits, ce qui pourrait entraîner des interruptions de service et des pertes de revenus.", "apres": "La société dépend de fournisseurs tiers pour les centres de données, les plateformes cloud et d'autres services critiques, ce qui crée des risques d'interruption de service et de perte de contrôle."}, {"champ": "risks[2].summary", "correction": "Amélioration de la formulation pour plus de précision", "avant": "La dépendance de la société à l'égard des tiers pourrait entraîner des risques pour son activité et sa réputation.", "apres": "La dépendance de la société à l'égard de fournisseurs tiers pour des services critiques pourrait entraîner des risques pour son activité et sa réputation en cas de défaillance de ces partenaires."}, {"champ": "risks[3].title", "correction": "Titre plus descriptif du contenu du risque", "avant": "Réglementation", "apres": "Évolution réglementaire et conformité"}, {"champ": "risks[3].score_rationale", "correction": "Enrichissement pour spécifier les domaines réglementaires pertinents pour Salesforce", "avant": "Les changements réglementaires pourraient avoir un impact négatif sur l'activité de la société et sa réputation.", "apres": "Les changements réglementaires en matière de protection des données, de confidentialité et d'IA pourraient imposer des coûts de conformité élevés et limiter certaines pratiques commerciales."}, {"champ": "risks[3].summary", "correction": "Amélioration pour spécifier les domaines réglementaires clés", "avant": "Les changements réglementaires pourraient entraîner des coûts et des complexités supplémentaires pour la société.", "apres": "Les changements réglementaires croissants en matière de protection des données, confidentialité et IA pourraient entraîner des coûts et des complexités supplémentaires pour la société."}, {"champ": "risks[4].title", "correction": "Titre plus descriptif", "avant": "Concurrence", "apres": "Intensification de la concurrence"}, {"champ": "risks[4].score_rationale", "correction": "Enrichissement pour contextualiser dans le secteur CRM et cloud", "avant": "La concurrence dans le secteur pourrait entraîner des pertes de parts de marché et des revenus.", "apres": "La concurrence intense dans le secteur du CRM et du cloud, notamment avec des acteurs majeurs et des nouveaux entrants axés sur l'IA, pourrait entraîner des pertes de parts de marché et une pression sur les prix."}, {"champ": "risks[4].summary", "correction": "Amélioration pour plus de précision sectorielle", "avant": "La concurrence dans le secteur pourrait avoir un impact négatif sur l'activité de la société et sa réputation.", "apres": "La concurrence intense dans le secteur du CRM et du cloud computing pourrait avoir un impact négatif sur les parts de marché, les prix et la croissance de la société."}, {"champ": "risks[5].title", "correction": "Titre plus spécifique reflétant le contexte d'acquisitions récentes", "avant": "Risques financiers", "apres": "Risques liés aux acquisitions et intégrations"}, {"champ": "risks[5].score_rationale", "correction": "Spécification des risques liés aux acquisitions majeures mentionnées dans le 10-K", "avant": "Les risques financiers pourraient entraîner des pertes de revenus et des difficultés pour la société.", "apres": "Les acquisitions récentes (Informatica, Regrello) présentent des risques d'intégration, de valorisation et de réalisation des synergies attendues, pouvant impacter les résultats financiers."}, {"champ": "risks[5].summary", "correction": "Enrichissement avec référence spécifique à l'acquisition Informatica mentionnée dans le 10-K", "avant": "Les risques financiers pourraient avoir un impact négatif sur l'activité de la société et sa réputation.", "apres": "Les risques liés aux acquisitions, notamment l'intégration d'Informatica pour 9,6 milliards de dollars, pourraient avoir un impact négatif sur les résultats financiers si les synergies attendues ne se matérialisent pas."}, {"champ": "risks[6].title", "correction": "Titre plus complet reflétant l'enjeu d'attraction en plus de la rétention", "avant": "Perte de personnel clé", "apres": "Perte de personnel clé et attraction de talents"}, {"champ": "risks[6].score_rationale", "correction": "Enrichissement pour contextualiser dans l'environnement technologique et IA", "avant": "La perte de personnel clé pourrait entraîner des difficultés pour la société.", "apres": "La perte de personnel clé, notamment dans un contexte de forte demande pour les talents en IA et technologie, pourrait ralentir l'innovation et l'exécution stratégique."}, {"champ": "risks[6].summary", "correction": "Amélioration pour souligner l'importance des talents en IA dans la stratégie actuelle", "avant": "La perte de personnel clé pourrait entraîner des difficultés pour la société.", "apres": "La perte de personnel clé et les difficultés à attirer et retenir des talents technologiques, notamment en IA, pourraient entraver l'exécution de la stratégie de l'entreprise."}, {"champ": "Validation générale", "statut": "Aucun KPI halluciné détecté - Toutes les valeurs numériques (41.5B revenue, 72.4B RPO, 35.1B current RPO, 20% operating margin, 15.0B cash from ops, 12.7B buybacks, 95% subscription revenue, 9.6B Informatica acquisition) sont confirmées dans le MD&A et les highlights de fiscal 2026", "note": "Les unités sont correctes (Mds $ utilisé de manière cohérente, % pour les marges et proportions). L'historique des KPIs est cohérent avec les tendances de croissance décrites."}], "_iterative_refinement": {"date": "2026-05-04 15:10", "kpis_added": 6, "model": "claude-sonnet-4-5", "cost_usd": 0.0246}, "governance": {"agm_date": "2026-05-28", "fiscal_year": 2026, "ceo_name": "Marc Benioff", "board_size": 12, "voting_structure": "Une seule classe d'actions ordinaires, 1 vote par action.", "top_capital": [{"name": "The Vanguard Group", "type": "institutionnel", "stake_pct": 10.2}, {"name": "BlackRock, Inc.", "type": "institutionnel", "stake_pct": 8.9}, {"name": "State Street Corporation", "type": "institutionnel", "stake_pct": 6}], "ceo_total_comp_m": 49.38, "top_voting": [], "board_independence_pct": 77, "exec_comp_approval_pct": 77, "ceo_pay_ratio": 296, "comp_detail": {"source_fiscal_year": 2026, "ceo_salary_m": 1.55, "ceo_bonus_m": 0, "ceo_stock_awards_m": 27.27, "ceo_option_awards_m": 10.74, "ceo_non_equity_incentive_m": 3.6, "ceo_other_m": 6.22, "ceo_total_comp_m": 49.38, "ceo_pay_ratio": 296, "median_employee_pay": 166753, "neo2_name": "Robin Washington", "neo2_total_comp_m": 28.45, "comp_vs_prior_year_pct": 