  "risks": [
    {
      "title": "Exécution stratégique",
      "category": "strategic",
      "severity": 3,
      "score_rationale": "A section Risks related to operating factors (tete ). Position haute mais langage conditionnel standard sans exposition chiffree. Citation: \"We may be unable to identify and complete acquisitions, investments, or development or redevelopment projects\". Position: haut Item 1A.",
      "trend": "stable",
      "summary": "Risques d'exécution sur les initiatives stratégiques, intégrations d'acquisitions ou transformations en cours.",
      "score": 3
    },
    {
      "title": "Risques financiers",
      "category": "financial",
      "severity": 3,
      "score_rationale": "La ligne de credit non securisee via des covenants, et exposition aux taux. Risque reel d'un REIT endette mais attenue (92% de baux triple net, escalades de loyers). Citation: \"restricts our ability to engage in certain business activities\". Position: bas Item 1A.",
      "trend": "stable",
      "summary": "Exposition à la volatilité financière : taux, change, crédit ou liquidité, pouvant affecter la rentabilité et la flexibilité.",
      "score": 3
    },
    {
      "title": "Dépendance aux tiers et fournisseurs",
      "category": "climate",
      "severity": 2,
      "score_rationale": "Simple sous-point des risques de developpement. Pas de section dediee, pas de chiffre, formulation prudentielle. Citation: \"we may also be forced to seek new third-party suppliers or contractors\". Position: haut Item 1A.",
      "trend": "stable",
      "summary": "Les projets de developpement d'Alexandria peuvent exiger de nouveaux fournisseurs ou sous-traitants non testes, avec des couts de materiaux et de main d'oeuvre plus eleves qu'anticipe.",
      "score": 2
    },
    {
      "title": "Risques réglementaires",
      "category": "regulatory",
      "severity": 2,
      "score_rationale": "Sous-points des risques de developpement: projets exposes aux. Risque reglementaire generique du secteur immobilier, sans developpement chiffre. Citation: \"changing zoning, land use, building, occupancy, or other government codes or regulations\". Position: haut Item 1A.",
      "trend": "stable",
      "summary": "Risques liés aux changements normatifs, enquêtes ou contentieux susceptibles d'imposer des sanctions ou de contraindre les opérations.",
      "score": 2
    },
    {
      "title": "Risques climatiques et environnementaux",
      "category": "climate",
      "severity": 2,
      "score_rationale": "Mentions dispersees: le changement climatique et la meteo severe et des exigences accrues sur les materiaux de construction. Pas de section dediee developpee ni d'exposition chiffree. Citation: \"may affect our ability to conduct business\". Position: milieu Item 1A.",
      "trend": "stable",
      "summary": "Risques climatiques physiques et transitionnels, exigences ESG croissantes et événements météo extrêmes.",
      "score": 2
    },
    {
      "title": "Environnement macroéconomique",
      "category": "macro",
      "severity": 3,
      "score_rationale": "Tete de l'les conditions la valeur des actifs, avec dependance explicite des locataires life science aux budgets R&D et financements. Position haute, langage conditionnel. Citation: \"in the capital markets and global economy... could adversely affect\". Position: haut Item 1A.",
      "trend": "stable",
      "summary": "Conjoncture macroéconomique défavorable : récession, inflation, tensions géopolitiques ou baisse de la consommation.",
      "score": 3
    }
  ],
