 "_segments_fetched_at": "2026-05-06T19:22:40.783581+00:00",
 "risks": [
  {
   "title": "Concurrence Nvidia sur les acc\u00e9l\u00e9rateurs IA",
   "category": "Concurrence",
   "severity": 4,
   "trend": "up",
   "score_rationale": "Premier risque narratif de l'Item 1A (~4-6%), Nvidia nommee : \"leverages its market position in data center GPU, financial resources, and proprietary software ecosystem\". Impact deja subi sur prix et volumes, mais sans exposition chiffree : 4.",
   "summary": "MI300 et MI325 doivent grignoter des parts sur l'IA d'entra\u00eenement. Un \u00e9cart persistant sur logiciel (ROCm vs CUDA) plafonnerait la trajectoire data center.",
   "score": 4
  },
  {
   "title": "D\u00e9pendance foundry TSMC et Ta\u00efwan",
   "category": "G\u00e9opolitique",
   "severity": 5,
   "trend": "up",
   "score_rationale": "Premier tiers de l'Item 1A (~21%), dependance totale d'un fabless envers TSMC : \"for the production of all wafers for microprocessor and GPU products\" a 7 nm et moins, avec langage fort (could be materially adversely affected) : 5.",
   "summary": "AMD est fabless et d\u00e9pend de TSMC pour tous ses n\u0153uds 5 nm et 3 nm. Toute perturbation \u00e0 Ta\u00efwan ou changement d'allocation wafers grillerait le carnet CPU/GPU.",
   "score": 5
  },
  {
   "title": "Contr\u00f4les export vers la Chine",
   "category": "G\u00e9opolitique",
   "severity": 3,
   "trend": "up",
   "score_rationale": "Seconde moitie de l'Item 1A (~54%), langage conditionnel : \"may limit our ability to export our products to certain customers\". Risque reel (licences BIS) mais presente sans chiffrage : 3.",
   "summary": "Les MI308, Radeon Pro et certains EPYC sont soumis \u00e0 licence export. Une extension des interdictions ou une riposte chinoise sur les composants r\u00e9duit la couverture g\u00e9ographique.",
   "score": 3
  },
  {
   "title": "Cyclicit\u00e9 PC et gaming",
   "category": "March\u00e9",
   "severity": 4,
   "trend": "stable",
   "score_rationale": "Haut de l'Item 1A (~7%), impact deja materialise : \"have materially adversely affected, and may continue to materially adversely affect\". Position haute et langage fort : 4.",
   "summary": "Le march\u00e9 PC reste tr\u00e8s cyclique et les consoles arrivent en fin de g\u00e9n\u00e9ration. Un creux simultan\u00e9 comprimerait le mix avant la rel\u00e8ve data center.",
   "score": 4
  },
  {
   "title": "Int\u00e9gration Xilinx et Pensando",
   "category": "Op\u00e9rationnel",
   "severity": 2,
   "trend": "down",
   "score_rationale": "Fin de l'Item 1A (~85%), langage prudentiel : \"may fail to materialize their anticipated benefits and could disrupt our business\". Integrations Xilinx/Pensando absorbees, risque residuel : 2.",
   "summary": "Les acquisitions Xilinx et Pensando ont \u00e9t\u00e9 absorb\u00e9es mais la roadmap FPGA/DPU reste sous surveillance. Un d\u00e9calage produit compromettrait la th\u00e8se embedded.",
   "score": 2
  },
  {
   "title": "Cybers\u00e9curit\u00e9 et vuln\u00e9rabilit\u00e9s mat\u00e9rielles",
   "category": "Cyber",
   "severity": 3,
   "trend": "up",
   "score_rationale": "Premier tiers de l'Item 1A (~31%) : \"subject to security vulnerabilities that could have a material adverse effect\". Langage fort mais risque produit standard, sans defaut chiffre : 3.",
   "summary": "Les failles de type Spectre ou Zenbleed exigent des mises \u00e0 jour microcode. Un d\u00e9faut majeur non patchable entamerait la confiance des hyperscalers.",
   "score": 3
  },
  {
   "title": "Litiges brevets et propri\u00e9t\u00e9 intellectuelle",
   "category": "Litige",
   "severity": 2,
   "trend": "stable",
   "score_rationale": "Haut de l'Item 1A (~19%) mais langage purement prudentiel : \"we cannot assure you that we will be able to adequately protect\". Risque IP generique sans contentieux chiffre : 2.",
   "summary": "AMD reste expos\u00e9 \u00e0 des contentieux brevets r\u00e9currents (VLSI, GlobalFoundries, universit\u00e9s). Les provisions actuelles couvrent l'essentiel mais un jugement lourd resterait possible.",
   "score": 2
  }
 ],
