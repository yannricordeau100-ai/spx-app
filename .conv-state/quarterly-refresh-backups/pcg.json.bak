  "risks": [
    {
      "title": "Risques de feux de forêt et inverse condemnation",
      "category": "Opérationnel",
      "severity": 5,
      "score_rationale": "Risque existentiel pour PG&E ; historique de faillite 2019 lié aux feux Camp Fire / Tubbs / North Bay. Doctrine inverse condemnation en Californie engage la responsabilité sans faute. Section dédiée Wildfires en tête Item 1A. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "Les feux de forêt déclenchés par les équipements PG&E peuvent générer des passifs colossaux via la doctrine d'inverse condemnation californienne, comme l'ont montré les faillites de 2001 et 2019.",
      "score": 5
    },
    {
      "title": "Réglementation et décisions CPUC",
      "category": "Réglementaire",
      "severity": 4,
      "score_rationale": "Toute revenue requirement, ROE, capex sont décidés par la California Public Utilities Commission (CPUC). Risque de rejet GRC, contestations politiques. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "Les revenus et investissements de PG&E sont entièrement encadrés par la CPUC, dont les décisions sur les General Rate Cases, ROE et programmes de hardening peuvent fortement impacter la rentabilité.",
      "score": 4
    },
    {
      "title": "Endettement massif et notation crédit",
      "category": "Financier",
      "severity": 4,
      "score_rationale": "Dette long terme >50 Mds$ post-faillite, notation crédit fragile (juste investment grade BBB-/Baa3). Sensibilité aux taux. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "PG&E porte une dette long terme supérieure à 50 milliards de dollars avec une notation crédit fragile, ce qui rend la société vulnérable à toute hausse de taux ou downgrade.",
      "score": 4
    },
    {
      "title": "Risques cyber et physiques sur le réseau électrique",
      "category": "Cybersécurité",
      "severity": 4,
      "score_rationale": "Infrastructure critique très exposée, NERC CIP, FERC. Cyberattaques sur grille américaine en hausse. (score par défaut, à affiner)",
      "trend": "up",
      "summary": "Les infrastructures critiques de PG&E (réseau de transmission, distribution, gaz) sont exposées à des cyberattaques ciblées et des attaques physiques, avec des conséquences potentiellement majeures.",
      "score": 4
    },
    {
      "title": "Transition énergétique et électrification accélérée",
      "category": "Stratégique",
      "severity": 3,
      "score_rationale": "Plan AB100 (100% renouvelables 2045), électrification massive Californie (BEV, data centers). Capex massif requis. (score par défaut, à affiner)",
      "trend": "up",
      "summary": "L'électrification massive de la Californie (véhicules, chauffage, data centers IA) et l'objectif 100% renouvelables 2045 imposent des investissements colossaux dont la rentabilité dépend de la CPUC.",
      "score": 3
    }
  ],
