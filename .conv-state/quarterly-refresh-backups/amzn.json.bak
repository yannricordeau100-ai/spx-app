 "stories_body_fr": [
  {
   "kpi_short": "AWS Revenue",
   "body_fr": "AWS est le leader mondial des services d'infrastructure cloud et offre une large gamme de services informatiques (compute, stockage, base de donn\u00e9es, analytique, machine learning) aux d\u00e9veloppeurs et entreprises."
  },
  {
   "kpi_short": "AI Investment",
   "body_fr": "Les investissements en infrastructure technologique et IA soutiennent le d\u00e9veloppement de nouveaux produits, services cloud et l'optimisation logistique. Amazon acc\u00e9l\u00e8re ses d\u00e9penses pour porter ses initiatives en IA."
  }
 ],
