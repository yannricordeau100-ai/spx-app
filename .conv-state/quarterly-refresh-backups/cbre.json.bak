  "risks": [
    {
      "title": "Ralentissement macro et cycles de l'immobilier commercial",
      "category": "Marché",
      "severity": 4,
      "trend": "up",
      "score_rationale": "Risque ouvrant, sensibilite directe des transactions immobilieres au cycle avec material adverse effect explicite. Citation: \"Our performance is significantly related to general economic, political and regulatory conditions\". Position: milieu Item 1A.",
      "summary": "Les revenus de CBRE dépendent directement des volumes de transactions et des valeurs d'actifs, très sensibles aux taux, à l'inflation et aux ralentissements économiques. Un cycle défavorable pèse sur commissions, fees et gains de co-investissement.",
      "score": 4
    },
    {
      "title": "Détérioration des marchés du crédit",
      "category": "Crédit",
      "severity": 3,
      "trend": "stable",
      "score_rationale": "Impact direct sur les volumes de transactions mais formulation conditionnelle sans exposition chiffree. Citation: \"If our clients are unable to obtain credit on favorable terms\". Position: haut Item 1A.",
      "summary": "Un accès au crédit plus rare ou plus coûteux réduit les volumes de leasing, sales et origination hypothécaire, et fragilise l'IM et le development services. Le contexte de taux élevés depuis 2023 reste un facteur d'alerte.",
      "score": 3
    },
    {
      "title": "Exposition devises et opérations internationales",
      "category": "Géopolitique",
      "severity": 3,
      "trend": "up",
      "score_rationale": "Presence internationale large mais risques presentes en liste conditionnelle sans chiffre. Citation: \"difficulties and costs of staffing and managing international operations\". Position: haut Item 1A.",
      "summary": "CBRE réalise près de 44% de son CA hors USD et opère dans de multiples juridictions. Fluctuations FX, tarifs, restrictions capitaux et incertitudes fiscales pèsent sur les résultats reportés et la mobilité des profits.",
      "score": 3
    },
    {
      "title": "Concurrence sectorielle et pression sur les marges",
      "category": "Concurrence",
      "severity": 2,
      "trend": "stable",
      "score_rationale": "Concurrence structurelle du courtage immobilier, langage conditionnel. Citation: \"We have numerous local, regional and global competitors across all of our business lines\". Position: haut Item 1A.",
      "summary": "CBRE fait face à des concurrents locaux, régionaux et globaux, incluant outsourcers et acteurs de niche. La résiliation contractuelle rapide et la consolidation sectorielle peuvent éroder parts de marché et niveaux de fees.",
      "score": 2
    },
    {
      "title": "Risques d'intégration des acquisitions",
      "category": "Opérationnel",
      "severity": 2,
      "trend": "stable",
      "score_rationale": "Risque d'integration classique des acquisitions, sans operation chiffree en cours. Citation: \"We have had, and may continue to experience, challenges in integrating operations\". Position: haut Item 1A.",
      "summary": "La croissance externe est un levier structurel pour CBRE mais expose à des surcoûts d'intégration, des pertes de talents ou de clients et à des synergies plus lentes qu'anticipé, sur fond de possible endettement additionnel.",
      "score": 2
    },
    {
      "title": "Co-investissements REI et projets de développement",
      "category": "Financier",
      "severity": 3,
      "trend": "stable",
      "score_rationale": "Capital propre engage en co-investissements et developpement, langage conditionnel. Citation: \"the value of our commercial real estate investments may be reduced\". Position: haut Item 1A.",
      "summary": "CBRE co-investit son capital dans des fonds et des projets de développement, avec des garanties de coût et de délai. Une baisse des valorisations ou un défaut d'un partenaire peut générer pertes, dilutions ou appels de fonds.",
      "score": 3
    },
    {
      "title": "Concentration clients et dépendance aux GSE",
      "category": "Crédit",
      "severity": 3,
      "trend": "stable",
      "score_rationale": "Dependance factuelle aux grands comptes et aux GSE, sans pourcentage divulgue. Citation: \"We have concentrations of business with large clients, which may cause increased credit risk\". Position: milieu Item 1A.",
      "summary": "Un portefeuille de gros clients et la dépendance à Fannie Mae et Freddie Mac exposent CBRE au risque de perte de contrat, de non-paiement ou de retrait d'agrément. Les contrats gouvernementaux ajoutent une exigence de compliance élevée.",
      "score": 3
    },
    {
      "title": "Rétention des cadres et des talents commerciaux",
      "category": "Personnel",
      "severity": 2,
      "trend": "stable",
      "score_rationale": "Risque de retention generique commun aux services, langage conditionnel sans exposition chiffree. Citation: \"Competition for employee talent can be intense\". Position: milieu Item 1A.",
      "summary": "La performance de CBRE repose sur ses dirigeants et sur des professionnels sales et leasing très mobiles. Un départ significatif ou un mauvais alignement des rémunérations peut peser sur le pipeline et les résultats opérationnels.",
      "score": 2
    }
  ],
