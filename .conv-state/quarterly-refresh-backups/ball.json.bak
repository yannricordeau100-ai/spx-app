  "risks": [
    {
      "title": "Coûts des matières premières et pass-through aluminium",
      "category": "Industriel",
      "severity": 4,
      "trend": "up",
      "score_rationale": "Langage fort et exposition concrete: l'aluminium est l'intrant principal (LME), litige douanier en cours sur les droits d'importation. Pas de chiffrage de part de cout, donc pas 5. Citation: \"could have a material adverse effect on our business, financial condition or results of operations\". Position: haut Item 1A.",
      "summary": "Une hausse brutale du prix de l'aluminium non répercutable via contrats compresse les marges d'exploitation.",
      "score": 4
    },
    {
      "title": "Concentration clients et fournisseurs (boissons)",
      "category": "Concurrence",
      "severity": 4,
      "trend": "stable",
      "score_rationale": "Perte d'un client cle qualifiee d'impact negatif significatif, la majorite des ventes va a un petit nombre de clients boissons. Citation: \"could have a significant negative impact on our sales\". Position: haut Item 1A.",
      "summary": "La perte ou renégociation défavorable d'un contrat majeur (top 5 clients) réduirait sensiblement les volumes.",
      "score": 4
    },
    {
      "title": "Tarifs douaniers et actions gouvernementales",
      "category": "Géopolitique",
      "severity": 3,
      "trend": "up",
      "score_rationale": "Langage fort et contentieux douanier reel en cours, mais sous-partie du risque matieres premieres. Citation: \"potential increases due to tariffs, sanctions, or other trade actions\". Position: haut Item 1A.",
      "summary": "De nouveaux tarifs sur l'aluminium ou l'acier compriment les marges ou déclenchent des revues contractuelles.",
      "score": 3
    },
    {
      "title": "Réglementation packaging et lois de consigne",
      "category": "Régulation",
      "severity": 2,
      "trend": "stable",
      "score_rationale": "Langage descriptif prudentiel, la societe note que des legislations similaires ont ete rejetees ailleurs. Citation: \"deposit systems and other container-related legislation have been adopted in some jurisdictions\". Position: bas Item 1A.",
      "summary": "Nouvelles lois EPR et consignes obligatoires modifient l'économie du recyclage et les mix produits.",
      "score": 2
    },
    {
      "title": "Événements climatiques et catastrophes",
      "category": "Climat",
      "severity": 2,
      "trend": "up",
      "score_rationale": "Risque meteo et climat generique en toute fin de liste, langage conditionnel faible. Citation: \"Adverse weather and climate changes may result in lower sales\". Position: bas Item 1A.",
      "summary": "Un événement extrême sur une usine majeure interromprait la production et affecterait la logistique aval.",
      "score": 2
    },
    {
      "title": "Cybersécurité",
      "category": "Cyber",
      "severity": 1,
      "trend": "up",
      "score_rationale": "Simple puce. Aucun risque cyber dedie: mention breve en puce sans aucun developpement. Citation: \"increased information technology (IT) security threats and reduced network access availability\". Position: milieu Item 1A.",
      "summary": "Une attaque sur les systèmes ERP ou usines connectées interromprait la production et les commandes clients.",
      "score": 1
    },
    {
      "title": "Litiges et procédures judiciaires",
      "category": "Litige",
      "severity": 2,
      "trend": "stable",
      "score_rationale": "Litiges usuels pour un industriel, langage prudentiel generique. Citation: \"could lead to litigation, governmental action or reputational damage\". Position: bas Item 1A.",
      "summary": "Contentieux produits, environnementaux ou commerciaux peuvent générer des coûts ponctuels.",
      "score": 2
    }
  ],
