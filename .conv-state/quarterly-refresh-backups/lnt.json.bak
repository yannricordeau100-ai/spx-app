 "ticker": "LNT",
 "risks": [
  {
   "title": "Data centers et concentration sur large load growth",
   "category": "Marché",
   "severity": 5,
   "score_rationale": "Tout premier bloc Item 1A avec section dédiée. Langage insistant sur risques de concentration, capex avancé et volatilité revenus. Nouveau risque prioritaire 2026 : Alliant s'est engagé sur data centers. Tendance new/up.",
   "trend": "new",
   "summary": "Alliant investit massivement en génération et transmission pour servir de nouveaux data centers. Toute défection, retard ou baisse de consommation client exposerait à des capex non récupérés et à une volatilité inédite du CA.",
   "score": 5
  },
  {
   "title": "Régulation tarifaire et rate cases IUC PSCW FERC",
   "category": "Régulation",
   "severity": 5,
   "score_rationale": "Section extensive dans Item 1A, langage détaillant multiples aléas (moratoire IPL jusqu'en 2029, rate refunds, caps). Catégorie critique pondérée fort pour un utility régulé. Position haute.",
   "trend": "up",
   "summary": "Les commissions IUC, PSCW et FERC fixent tarifs et taux de retour. Tout retard, refus ou décision défavorable réduirait les revenus autorisés et le retour sur capitaux investis.",
   "score": 5
  },
  {
   "title": "Cyberattaques d'états-nations sur infrastructures critiques",
   "category": "Cyber",
   "severity": 4,
   "score_rationale": "Section dédiée avec mention nominale de VOLT TYPHOON et SALT TYPHOON. Langage explicite (\"full or partial disruption\"). Catégorie pondérée fort (cyber sur critical infrastructure). Tendance up avec IA offensive citée.",
   "trend": "up",
   "summary": "Alliant est ciblé par des acteurs étatiques sur ses systèmes de production et distribution. Une intrusion pourrait couper le service, engager la responsabilité et coûter des remédiations lourdes.",
   "score": 4
  },
  {
   "title": "Réglementation GHG et transition énergétique",
   "category": "Régulation",
   "severity": 4,
   "score_rationale": "Section climat GHG longue dans Item 1A. Langage insiste sur retraits potentiels de crédits IRA via OBBB Act, litiges climat, refus de recouvrement. Poids catégoriel fort. Tendance up avec pipeline renouvelable engagé.",
   "trend": "up",
   "summary": "Un durcissement GHG, un retrait des crédits d'impôt IRA via l'OBBB Act ou un refus régulatoire de recouvrer les coûts de transition menacerait la roadmap renouvelable d'Alliant.",
   "score": 4
  },
  {
   "title": "Physiques du changement climatique et météo extrême",
   "category": "Climat",
   "severity": 4,
   "score_rationale": "Section physiques climat détaillée. Utility exposé aux tempêtes, températures extrêmes, sécheresses. Catégorie pondérée fort. Position milieu-haute.",
   "trend": "up",
   "summary": "Tempêtes, canicules et froid extrême exposent le réseau et les EGUs d'Alliant. Un événement majeur pourrait couper le service, endommager les actifs et déclencher des enquêtes régulatoires.",
   "score": 4
  },
  {
   "title": "Risques de construction et EPC de grands projets",
   "category": "Opérationnel",
   "severity": 3,
   "score_rationale": "Section dédiée large construction projects, langage listant retards permis, tarifs, main d'oeuvre, contrats. Poids modéré, mais matérialisé sur le pipeline renouvelable et gas-fired. Position milieu.",
   "trend": "stable",
   "summary": "Les projets d'énergie renouvelable et de gaz d'Alliant subissent risques de permis, tarifs matériaux, disponibilité main d'oeuvre et surcoûts. Tout dérapage pèserait sur les rendements autorisés.",
   "score": 3
  },
  {
   "title": "Crédits d'impôt renouvelables et OBBB Act",
   "category": "Fiscal",
   "severity": 3,
   "score_rationale": "Section dédiée aux tax credits, langage mentionne explicitement OBBB Act et limites sur cessions PTC/ITC. Position milieu. Tendance up (durcissement).",
   "trend": "up",
   "summary": "L'OBBB Act accélère la fin des PTC et ITC. Une incapacité à qualifier ou vendre les crédits fiscaux renouvelables ampute la rentabilité des projets solaires et de stockage.",
   "score": 3
  },
  {
   "title": "Saisonnalité et sensibilité à la météo",
   "category": "Marché",
   "severity": 2,
   "score_rationale": "Section dédiée avec langage prudent (\"may fluctuate substantially\"). Poids modéré, phénomène récurrent inhérent au métier utility. Position milieu-basse.",
   "trend": "stable",
   "summary": "La demande dépend fortement des températures. Un hiver doux ou un été frais réduirait le volume vendu et la contribution des tarifs saisonniers.",
   "score": 2
  },
  {
   "title": "Baisse structurelle de demande (auto-production, efficacité)",
   "category": "Marché",
   "severity": 2,
   "score_rationale": "Section dédiée dans Item 1A. Langage prudent (\"may decrease\"). Position basse pour Alliant, tendance up structurellement mais compensée par data centers. Poids modéré.",
   "trend": "stable",
   "summary": "Auto-production solaire client, efficacité énergétique et renouvelable derrière compteur érodent le volume vendu. Alliant doit ajuster tarifs et mix pour compenser cette érosion.",
   "score": 2
  },
  {
   "title": "Environnement et coûts de remédiation",
   "category": "Régulation",
   "severity": 2,
   "score_rationale": "Section environnementale plus classique, langage neutre. Position basse. Poids modéré pour un utility charbon en transition. Tendance stable.",
   "trend": "stable",
   "summary": "Alliant reste exposé aux normes air, eau, coal combustion residuals et remédiation. Toute non-conformité peut déclencher amendes ou capex de mise en conformité non récupérable.",
   "score": 2
  }
 ],
