  "risks": [
    {
      "title": "Cyclicité du marché automobile et demande des consommateurs",
      "category": "Marché",
      "severity": 4,
      "score_rationale": "Citation du 10-K : \"may adversely affect demand and pricing in the used vehicle market\" (premier facteur de l'Item 1A). Note 4/5 : risque en tete avec effets deja constates (taux, inflation), sans langage maximal.",
      "trend": "up",
      "summary": "Une baisse de la demande des consommateurs ou des taux d'intérêt élevés réduit les volumes de Carvana et les marges sur les financements.",
      "score": 4
    },
    {
      "title": "Endettement élevé et liquidité",
      "category": "Financier",
      "severity": 4,
      "score_rationale": "Citation du 10-K : \"prevent us from fulfilling our obligations under our financing agreements\" (derniere section de l'Item 1A). Note 4/5 : endettement detaille et chiffre avec risque de probleme de liquidite substantiel, mais position basse.",
      "trend": "up",
      "summary": "Le niveau d'endettement élevé de Carvana expose la société à un risque de liquidité majeur en cas de récession ou de hausse durable des taux.",
      "score": 4
    },
    {
      "title": "Dépendance aux ventes de créances automobiles (titrisation)",
      "category": "Financier",
      "severity": 4,
      "score_rationale": "Citation du 10-K : \"sale of automotive finance receivables for a substantial portion of our gross profit\" (seconde moitie de l'Item 1A). Note 4/5 : dependance explicite pour une part substantielle du gross profit.",
      "trend": "up",
      "summary": "Une dégradation du marché des ABS automobiles ou des taux de défaut réduit la profitabilité des ventes de créances de Carvana.",
      "score": 4
    },
    {
      "title": "Concurrence intense (CarMax, dealers traditionnels)",
      "category": "Concurrence",
      "severity": 3,
      "score_rationale": "Citation du 10-K : \"pressure from existing and new companies may adversely affect our business and operating results\" (premier quart de l'Item 1A). Note 3/5 : marche decrit comme tres fragmente et concurrentiel, langage conditionnel standard.",
      "trend": "stable",
      "summary": "La concurrence de CarMax et des dealers traditionnels ayant accéléré leurs offres en ligne menace la croissance et les marges de Carvana.",
      "score": 3
    },
    {
      "title": "Réputation, qualité du service et exécution opérationnelle",
      "category": "Opérationnel",
      "severity": 3,
      "score_rationale": "Citation du 10-K : \"our reputation as a company of integrity are critical to our success\" (premier quart de l'Item 1A). Note 3/5 : reputation presentee comme critique mais langage conditionnel standard.",
      "trend": "stable",
      "summary": "Des défaillances opérationnelles (livraison, titres, certifications) peuvent ternir durablement la marque Carvana et entraîner des actions consommateurs.",
      "score": 3
    },
    {
      "title": "Cybersécurité et disruption des systèmes technologiques",
      "category": "Cybersécurité",
      "severity": 3,
      "score_rationale": "Citation du 10-K : \"could damage our reputation and harm our business and operating results\" (milieu de l'Item 1A). Note 3/5 : risque cyber standard, langage conditionnel, sans exposition chiffree.",
      "trend": "up",
      "summary": "Une cyberattaque ou panne majeure des systèmes Carvana suspend la capacité de vente en ligne et compromet les données clients.",
      "score": 3
    }
  ],
