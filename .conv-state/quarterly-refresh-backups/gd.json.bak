  "risks": [
    {
      "title": "Government Spending Dependency",
      "category": "Macro",
      "severity": 4,
      "score_rationale": "Premier risque de l'Item 1A : \"Approximately 70% of our consolidated revenue was from the U.S. government\". Concentration client chiffree majeure en tete de section, meme si le langage reste mesure (\"could impact\") : 4/5.",
      "trend": "stable",
      "summary": "The company is heavily dependent on U.S. government spending levels, particularly defense budgets. While current demand is strong, changes in administration priorities or fiscal constraints could materially impact revenues and profitability.",
      "score": 4
    },
    {
      "title": "Contraintes de chaîne d'approvisionnement et inflation",
      "category": "Industriel",
      "severity": 3,
      "score_rationale": "Item 1A (~45%, milieu de section) : \"We sometimes rely on only one or two sources of supply\". Dependance concrete (semi-conducteurs cites) avec langage \"materially adversely affected\" mais sans chiffrage : 3/5.",
      "trend": "up",
      "summary": "Supply chain constraints, labor shortages, and inflationary pressures threaten production capacity and margins. The company must invest in facilities and workforce expansion to meet growing defense demand while managing input cost inflation and tariff impacts.",
      "score": 3,
      "title_en": "Supply Chain Constraints and Inflation"
    },
    {
      "title": "Conflits géopolitiques et régionaux",
      "category": "Geopolitique",
      "severity": 3,
      "score_rationale": "Item 1A (~60%, bloc International Operations) : \"the ongoing conflict between Russia and Ukraine has resulted in the imposition\". Risque presente comme un risque d'operations internationales de milieu de section, langage conditionnel : 3/5.",
      "trend": "up",
      "summary": "Ongoing regional conflicts including the Israel-Hamas conflict and Eastern European tensions create both demand opportunities and operational risks. Conflicts can disrupt supply chains, restrict market access, and impact manufacturing schedules.",
      "score": 3,
      "title_en": "Geopolitical and Regional Conflicts"
    },
    {
      "title": "Risque de montée en production et d'exécution",
      "category": "Industriel",
      "severity": 3,
      "score_rationale": "Item 1A (~35%) : \"the profitability of contracts could be adversely affected\". Risque d'execution des contrats a estimations, langage \"materially\" mais presentation standard de milieu de section : 3/5.",
      "trend": "stable",
      "summary": "Significant investments in new product development and production capacity expansion carry execution risk. New aircraft models and defense programs may experience margin pressure during ramp-up phases and could face delays or cost overruns.",
      "score": 3,
      "title_en": "Production Ramp and Execution Risk"
    },
    {
      "title": "Risque cybersécurité et technologie",
      "category": "Technologie",
      "severity": 2,
      "score_rationale": "Item 1A (~80%, bloc Other Business Risks) : \"Such prior events have not had a material impact\". La ste indique elle-meme qu'aucun incident cyber n'a ete materiel, position basse : 2/5.",
      "trend": "up",
      "summary": "Cybersecurity threats pose material risks to operations, intellectual property, and customer data. Defense industry prominence makes the company a high-value target for sophisticated cyber attacks.",
      "score": 2,
      "title_en": "Cybersecurity and Technology Risk"
    },
    {
      "title": "Risque contractuel et contentieux",
      "category": "Litige",
      "severity": 3,
      "score_rationale": "Item 1A (~18%, haut de section) : \"civil or criminal penalties and administrative sanctions could result\". Environnement d'audit gouvernemental permanent avec risque de suspension des contrats : 3/5.",
      "trend": "stable",
      "summary": "Government contracts involve performance obligations, compliance requirements, and potential disputes that could result in litigation, penalties, or contract modifications affecting profitability.",
      "score": 3,
      "title_en": "Contract and Litigation Risk"
    },
    {
      "title": "Risque main‑d’œuvre et personnel clé",
      "category": "Personne-clé",
      "severity": 2,
      "score_rationale": "Item 1A (~40%) : \"To the extent that the demand for skilled personnel exceeds supply\". Risque talents generique du secteur, langage conditionnel : 2/5.",
      "trend": "up",
      "summary": "Ability to hire and retain skilled engineers and manufacturing workers is constrained by demographic workforce challenges. Labor shortages and competition for talent could impact production capacity and new product development.",
      "score": 2,
      "title_en": "Workforce and Key Personnel Risk"
    },
    {
      "title": "Commercial Aircraft Market Cyclicality",
      "category": "Marché",
      "severity": 3,
      "score_rationale": "Item 1A (~25%) : \"Our Aerospace segment is subject to changing customer demand for business aircraft\". Cyclicite reelle du marche des jets d'affaires, langage \"could materially affect\" : 3/5.",
      "trend": "stable",
      "summary": "Commercial business aircraft market is cyclical and sensitive to economic conditions. While Aerospace segment performs well in current environment, economic slowdowns could reduce demand for new aircraft and impact segment growth.",
      "score": 3
    }
