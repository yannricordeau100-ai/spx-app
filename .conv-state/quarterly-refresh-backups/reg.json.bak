 "risks": [
  {
   "title": "Concentration sur centres commerciaux ancrés alimentation",
   "category": "operational",
   "severity": 3,
   "score_rationale": "Sévérité 3/5 : Regency Centers indique que la défaillance ou départ d'enseignes ancres grocery pourrait avoir un material adverse effect sur trafic, occupation et revenus locatifs.",
   "trend": "stable",
   "summary": "Modèle concentré sur shopping centers ancrés par supermarchés exposant à la santé du retail alimentaire et au départ d'enseignes ancres.",
   "score": 3
  },
  {
   "title": "Hausse des taux d'intérêt sur coût de financement",
   "category": "financial",
   "severity": 4,
   "score_rationale": "Sévérité 4/5 : le REIT cite explicitement l'environnement de taux comme pouvant impacter materialement coût de la dette, refinancements et valorisation immobilière.",
   "trend": "increasing",
   "summary": "Sensibilité du REIT aux taux d'intérêt impactant coût de la dette à refinancer, taux de capitalisation et valeur du portefeuille.",
   "score": 4
  },
  {
   "title": "Mutation du retail et e-commerce",
   "category": "competitive",
   "severity": 3,
   "score_rationale": "Sévérité 3/5 : la société identifie le shift vers le commerce en ligne comme risque pour la demande d'espaces commerciaux avec material adverse effect potentiel.",
   "trend": "stable",
   "summary": "Évolution structurelle du commerce vers digital et omnicanal impactant demande locative pour les espaces commerciaux traditionnels.",
   "score": 3
  },
  {
   "title": "Maintien du statut REIT",
   "category": "regulatory",
   "severity": 3,
   "score_rationale": "Sévérité 3/5 : Regency cite la complexité de conformité aux règles REIT (distribution 90%, composition actifs/revenus) avec material adverse effect en cas de perte du statut fiscal.",
   "trend": "stable",
   "summary": "Risque de perte du statut fiscal REIT entraînant taxation corporate et impact significatif sur dividendes et valorisation.",
   "score": 3
  },
  {
   "title": "Risques climatiques et catastrophes naturelles",
   "category": "operational",
   "severity": 3,
   "score_rationale": "Sévérité 3/5 : exposition portefeuille en Floride, Texas et Californie à ouragans, incendies, inondations qualifiés de risques matériels pour les actifs immobiliers.",
   "trend": "increasing",
   "summary": "Vulnérabilité du portefeuille immobilier aux ouragans, inondations et incendies, particulièrement sur les marchés Sun Belt.",
   "score": 3
