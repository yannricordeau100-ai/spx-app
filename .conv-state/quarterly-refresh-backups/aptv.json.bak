 "risks": [
  {
   "title": "Risques climatiques et environnementaux",
   "category": "climate",
   "severity": 2,
   "score_rationale": "Risque traite dans le dernier tiers de l'Item 1A: \"We may be adversely affected by laws or regulations\". Formulation prudentielle generique, sans exposition chiffree propre a Aptiv: 2/5.",
   "trend": "stable",
   "summary": "Risques climatiques physiques et transitionnels, exigences ESG croissantes et \u00e9v\u00e9nements m\u00e9t\u00e9o extr\u00eames.",
   "score": 2
  },
  {
   "title": "Mati\u00e8res premi\u00e8res",
   "category": "operational",
   "severity": 4,
   "score_rationale": "Tout premier risque de l'Item 1A: \"Disruptions in the supply of raw materials... may adversely affect our profitability\", avec langage materiel (\"could materially decrease our profit margins\") et vulnerabilite concrete du juste-a-temps automobile (cuivre, resines, semi-conducteurs): 4/5.",
   "trend": "stable",
   "summary": "Aptiv depend de cuivre, resines petrolieres, composants electroniques et semi-conducteurs livres en juste-a-temps: toute rupture d'approvisionnement peut reduire la production et comprimer materiellement les marges.",
   "score": 4
  },
  {
   "title": "Capacit\u00e9s de production",
   "category": "operational",
   "severity": 3,
   "score_rationale": "Milieu de l'Item 1A: \"could be adversely affected if our third-party suppliers lack sufficient quality control\". Dependance aux fournisseurs et fabricants tiers developpee mais langage conditionnel standard, sans chiffre: 3/5.",
   "trend": "stable",
   "summary": "Aptiv s'appuie sur des fournisseurs et fabricants tiers pour des composants et produits finis, avec des risques de qualite et de capacite de production.",
   "score": 3
  },
  {
   "title": "Environnement macro\u00e9conomique",
   "category": "financial",
   "severity": 3,
   "score_rationale": "Premier tiers de l'Item 1A: \"A prolonged downturn in or uncertainty relating to global or regional economic conditions\" pourrait reduire significativement la production automobile. Cyclicite sectorielle reelle, chiffres de production cites, langage conditionnel: 3/5.",
   "trend": "stable",
   "summary": "La demande d'Aptiv suit la production automobile mondiale, cyclique et sensible aux ralentissements economiques regionaux (Chine, Europe, Amerique du Nord).",
   "score": 3
  },
  {
   "title": "Pression concurrentielle",
   "category": "competitive",
   "severity": 2,
   "score_rationale": "Premier tiers de l'Item 1A mais formulation descriptive generique: l'industrie cliente est \"subject to rapid technological change, vigorous competition\" et consolidation. Risque concurrentiel commun a tous les equipementiers, sans exposition chiffree: 2/5.",
   "trend": "stable",
   "summary": "Pression concurrentielle accrue, \u00e9rosion potentielle des parts de march\u00e9 et compression des marges face \u00e0 de nouveaux entrants.",
   "score": 2
  },
  {
   "title": "Concurrence en Chine",
   "category": "competitive",
   "severity": 3,
   "score_rationale": "Premier tiers de l'Item 1A: \"Our business in China is subject to aggressive competition\" et \"Maintaining a strong position in the Chinese market is a key component\". Exposition strategique explicite au marche chinois: 3/5.",
   "trend": "stable",
   "summary": "Le marche chinois, pilier de la strategie de croissance d'Aptiv, est tres concurrentiel face aux constructeurs locaux et mondiaux, et sensible aux conditions economiques.",
   "score": 3
  },
  {
   "title": "Ex\u00e9cution strat\u00e9gique",
   "category": "strategic",
   "severity": 3,
   "score_rationale": "Section dediee en fin d'Item 1A mais evenement concret et majeur: la separation annoncee de l'activite Electrical Distribution Systems (Versigent) \"may not achieve the intended benefits\" et pourrait ne pas se realiser dans les delais. Execution reelle en cours: 3/5.",
   "trend": "stable",
   "summary": "La scission annoncee en janvier 2025 de l'activite Electrical Distribution Systems (Versigent) comporte des risques d'execution, de calendrier et de benefices non atteints.",
   "score": 3
  }
 ],
