  "risks": [
    {
      "title": "Cyclicité des marchés industriels et aérospatiaux",
      "category": "Cyclicité",
      "severity": 5,
      "score_rationale": "Le 10-K Honeywell met en avant la sensibilité aux cycles industriels et aérospatiaux. Aerospace Technologies dépend des livraisons OEM et de l'aftermarket commercial, Industrial Automation des capex industriels mondiaux. Langage explicite sur les cycles différenciés par segment. Pondération cyclicité élevée. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "Les revenus Honeywell sont exposés aux cycles industriels et aérospatiaux, avec dépendance aux capex industriels et aux livraisons OEM Boeing/Airbus.",
      "score": 3
    },
    {
      "title": "Concentration aerospace sur Boeing et Airbus",
      "category": "Concentration",
      "severity": 4,
      "score_rationale": "Honeywell Aerospace dépend fortement des programmes Boeing 737 MAX et 787 ainsi qu'Airbus A320neo. Le 10-K mentionne explicitement les impacts des problèmes qualité Boeing et les délais de livraison. Catégorie concentration client moyenne mais matérielle. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "Honeywell Aerospace est exposée à la concentration sur Boeing et Airbus, et notamment aux retards et problèmes qualité affectant les cadences.",
      "score": 3
    },
    {
      "title": "Restructuration spin-off et exécution stratégique",
      "category": "Stratégique",
      "severity": 4,
      "score_rationale": "Le 10-K détaille les plans de séparation annoncés (Solstice Advanced Materials puis Aerospace) annoncés en 2025. Risque d'exécution important sur la mise en place de structures séparées, allocations de dette et coûts dis-synergies. Pondération stratégique forte sur la période. (score par défaut, à affiner)",
      "trend": "up",
      "summary": "Honeywell engage des spin-offs majeurs (Solstice, Aerospace) générant des risques d'exécution, coûts dis-synergies et dilution de focus opérationnel.",
      "score": 3
    },
    {
      "title": "Cybersécurité IoT et infrastructure critique",
      "category": "Cybersécurité",
      "severity": 4,
      "score_rationale": "Les solutions Honeywell connectent des infrastructures critiques (usines, aéroports, bâtiments). Le 10-K met en avant le risque d'incidents OT/IT pouvant impacter clients et la responsabilité produit étendue. Langage renforcé. Tendance haussière sectorielle. (score par défaut, à affiner)",
      "trend": "up",
      "summary": "Les solutions IoT Honeywell connectent des infrastructures critiques, exposant à des incidents OT/IT avec responsabilité produit étendue.",
      "score": 3
    },
    {
      "title": "Passifs environnementaux et obligations légacy",
      "category": "Environnemental",
      "severity": 4,
      "score_rationale": "Honeywell porte d'importants passifs environnementaux hérités de Allied Signal (sites Superfund, PFAS). Le 10-K détaille les provisions et incertitudes sur les coûts de remédiation futurs. Catégorie environnemental pondération élevée historiquement pour Honeywell. (score par défaut, à affiner)",
      "trend": "stable",
      "summary": "Honeywell porte des passifs environnementaux légacy importants (sites Superfund, PFAS) avec incertitude sur les coûts futurs de remédiation.",
      "score": 3
    },
    {
      "title": "Tensions commerciales et tarifs sur chaîne d'approvisionnement",
      "category": "Géopolitique",
      "severity": 4,
      "score_rationale": "Le 10-K développe les risques liés aux tarifs douaniers US-Chine, contrôles à l'export et bifurcation des chaînes. Honeywell a une présence industrielle importante en Chine et en Inde. Tendance haussière sur la période. (score par défaut, à affiner)",
      "trend": "up",
      "summary": "Les tensions commerciales US-Chine, tarifs et contrôles à l'export affectent les opérations industrielles de Honeywell en Asie.",
      "score": 3
    }
  ],
