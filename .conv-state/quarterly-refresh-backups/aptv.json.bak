 "risks_rationale_overrides": [
  {
   "title": "Perturbations de la cha\u00eene d'approvisionnement mondiale",
   "category": "Industriel",
   "score_rationale": "Ce risque est identifi\u00e9 comme le risque n\u00b02 sur 3 dans l'Item 1A du 10-K (1), ce qui indique une priorit\u00e9 \u00e9lev\u00e9e. L'intensit\u00e9 du langage est moyenne avec l'usage de \"peuvent entra\u00eener\" (2). Par rapport \u00e0 l'ann\u00e9e pr\u00e9c\u00e9dente, le risque est stable, sans aggravation ni att\u00e9nuation notable (3). La cat\u00e9gorie \"Industriel\" a un poids bas par rapport aux risques cyber ou r\u00e9glementaires (4). Ces facteurs expliquent le score mod\u00e9r\u00e9 de 3 sur 5.",
   "_enriched_at": "2026-05-27T03:03:46.274763+00:00",
   "_enriched_by": "CONV-CONCEPTS sub-agent #24 Cerebras Qwen-3 235B"
  },
  {
   "title": "Risques g\u00e9opolitiques et barri\u00e8res commerciales",
   "category": "G\u00e9opolitique",
   "score_rationale": "Ce risque est class\u00e9 en position #3 sur 3 dans l'Item 1A du 10-K (1), ce qui indique une priorit\u00e9 \u00e9lev\u00e9e. L'intensit\u00e9 du langage est moyenne avec l'usage de 'pourraient' (2). Par rapport \u00e0 l'ann\u00e9e pr\u00e9c\u00e9dente, le risque est stable, sans aggravation ni att\u00e9nuation notable (3). La cat\u00e9gorie 'g\u00e9opolitique' a un poids bas selon notre grille de notation (4), ce qui limite son score malgr\u00e9 sa position centrale.",
   "_enriched_at": "2026-05-27T03:03:50.489445+00:00",
