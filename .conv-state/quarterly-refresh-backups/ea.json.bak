  "risks": [
    {
      "title": "Canaux de distribution et logistique",
      "category": "competitive",
      "severity": 3,
      "score_rationale": "Note 3/5 : milieu de l'Item 1A, \"A significant percentage of our digital net revenue is attributable to sales\" via Sony, Microsoft, Apple et Google. Dependance plateforme reelle mais langage conditionnel, sans pourcentage.",
      "trend": "stable",
      "summary": "L'intensification de la concurrence ou l'arrivée de nouveaux acteurs peut éroder les parts de marché, comprimer les marges et limiter le pouvoir de fixation des prix.",
      "score": 3
    },
    {
      "title": "Intensification de la concurrence",
      "category": "competitive",
      "severity": 3,
      "score_rationale": "Note 3/5 : premier risque strategique de l'Item 1A, \"Competition in our business is intense\". Concurrence structurelle du jeu video, formulation conditionnelle sans exposition chiffree.",
      "trend": "stable",
      "summary": "L'intensification de la concurrence ou l'arrivée de nouveaux acteurs peut éroder les parts de marché, comprimer les marges et limiter le pouvoir de fixation des prix.",
      "score": 3
    },
    {
      "title": "Risque spécifique au business model",
      "category": "operational",
      "severity": 4,
      "score_rationale": "Note 4/5 : haut de la section strategique, \"underperformance of a single major title has had, and could in the future have\" un impact defavorable materiel. Concentration sur EA SPORTS FC explicitement reconnue et deja subie.",
      "trend": "stable",
      "summary": "Un risque opérationnel identifié dans le filing pourrait perturber la production, la distribution ou la qualité de service.",
      "score": 4
    },
    {
      "title": "Risque réputationnel",
      "category": "operational",
      "severity": 3,
      "score_rationale": "Note 3/5 : haut de l'Item 1A, actions deja prises (reports de jeux) qui \"have had a negative impact on our financial results\". Impact reel mais modere, longuement nuance.",
      "trend": "stable",
      "summary": "Un risque opérationnel identifié dans le filing pourrait perturber la production, la distribution ou la qualité de service.",
      "score": 3
    },
    {
      "title": "Risque d'exécution opérationnelle",
      "category": "operational",
      "severity": 3,
      "score_rationale": "Note 3/5 : haut de l'Item 1A, \"We have experienced development delays for our products and services in the past\". Retards reels passes, consequences potentielles importantes en periode cle de vente.",
      "trend": "stable",
      "summary": "Un risque opérationnel identifié dans le filing pourrait perturber la production, la distribution ou la qualité de service.",
      "score": 3
    },
    {
      "title": "Attraction et rétention des talents",
      "category": "operational",
      "severity": 2,
      "score_rationale": "Note 2/5 : seconde moitie de l'Item 1A, \"The market for highly-skilled workers and leaders in our industry is extremely competitive\". Risque talent generique au secteur, langage prudentiel.",
      "trend": "stable",
      "summary": "La difficulté à attirer et retenir les talents clés peut limiter la capacité d'exécution stratégique et opérationnelle.",
      "score": 2
    }
  ],
