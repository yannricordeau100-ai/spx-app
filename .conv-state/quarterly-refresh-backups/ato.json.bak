 "risks": [
  {
   "title": "Recouvrement tarifaire et d\u00e9cisions des r\u00e9gulateurs",
   "category": "R\u00e9gulation",
   "severity": 4,
   "trend": "stable",
   "score_rationale": "Tout premier risque de l'Item 1A (Regulatory and Legislative Risks): \"our returns are continuously monitored and are subject to challenge\" et \"Regulatory lag could significantly increase\" si les mecanismes tarifaires sont modifies. Coeur du modele d'utility regulee, position en tete, mais sans langage maximal ni chiffre d'exposition: 4/5.",
   "summary": "Un refus ou retard de recouvrement par les commissions (Texas notamment) sur les hausses de capex compromet ROE et cash flows.",
   "score": 4
  },
  {
   "title": "Int\u00e9grit\u00e9 des pipelines et s\u00e9curit\u00e9 op\u00e9rationnelle",
   "category": "Op\u00e9rationnel",
   "severity": 3,
   "trend": "stable",
   "score_rationale": "Premiere section Operational Risks (premier tiers de l'Item 1A): \"We may incur significant costs and liabilities resulting from pipeline integrity\" et pertes potentielles \"could be large\" pres des zones peuplees. Langage serieux mais conditionnel, couts juges recouvrables via les tarifs: 3/5.",
   "summary": "Un incident majeur (explosion, fuite) d\u00e9clencherait pertes humaines, amendes PHMSA et travaux forc\u00e9s massifs.",
   "score": 3
  },
  {
   "title": "Cyber-attaques sur infrastructure \u00e9nerg\u00e9tique",
   "category": "Cyber",
   "severity": 3,
   "trend": "up",
   "score_rationale": "Section Technology and Cybersecurity Risks (seconde moitie de l'Item 1A) mais langage fort: une attaque \"could have a material adverse effect on our business reputation\" et les infrastructures pipeline \"may be specifically targeted\" selon les alertes du gouvernement americain. Specificite sectorielle reelle, position basse: 3/5.",
   "summary": "Une intrusion sur les syst\u00e8mes SCADA ou OT interromprait la distribution et exposerait les donn\u00e9es client.",
   "score": 3
  },
  {
   "title": "Transition climatique et politiques anti-fossiles",
   "category": "Climat",
   "severity": 2,
   "trend": "up",
   "score_rationale": "Section Climate Risks (deuxieme moitie de l'Item 1A): la legislation GHG \"could increase our operating costs\". Formulation conditionnelle et mitigant explicite: six des huit Etats desservis ont vote des lois empechant les interdictions locales de gaz: 2/5.",
   "summary": "Interdictions locales de gaz dans les nouveaux b\u00e2timents et taxes carbone menacent le volume long terme.",
   "score": 2
  },
  {
   "title": "Concentration g\u00e9ographique au Texas",
   "category": "Op\u00e9rationnel",
   "severity": 3,
   "trend": "stable",
   "score_rationale": "Position basse dans l'Item 1A mais exposition chiffree: \"Approximately 75 percent of our consolidated operations are located in the State of Texas\". Concentration geographique reelle, langage toutefois modere (\"may be significantly affected\") et cadre reglementaire texan historiquement favorable: 3/5.",
   "summary": "Un \u00e9v\u00e9nement m\u00e9t\u00e9o majeur (winter storm Uri) ou une crise \u00e9conomique r\u00e9gionale au Texas affecte disproportionnellement l'activit\u00e9.",
   "score": 3
  },
  {
   "title": "Acc\u00e8s aux march\u00e9s de capitaux",
   "category": "Financier",
   "severity": 3,
   "trend": "stable",
   "score_rationale": "Section Financial, Economic, and Market Risks (fin de l'Item 1A) mais langage appuye: une deterioration des marches de credit \"could be material and adverse to us\". Modele capital-intensif dependant d'un acces continu aux marches, note investment grade en mitigant: 3/5.",
   "summary": "Une hausse persistante des taux ou fermeture temporaire des march\u00e9s obligataires rench\u00e9rit le financement du plan capex.",
   "score": 3
  },
  {
   "title": "M\u00e9t\u00e9o extr\u00eame et catastrophes naturelles",
   "category": "Climat",
   "severity": 2,
   "trend": "up",
   "score_rationale": "Section Climate Risks: \"Adverse weather conditions could affect our operations or financial results\", avec mitigant chiffre fort: tarifs normalises meteo sur environ 97% des revenus residentiels et commerciaux. Risque largement couvert: 2/5.",
   "summary": "\u00c9v\u00e9nements extr\u00eames (winter storm, hurricanes) endommagent le r\u00e9seau et d\u00e9clenchent r\u00e9parations co\u00fbteuses non totalement recouvrables.",
   "score": 2
  }
 ],
