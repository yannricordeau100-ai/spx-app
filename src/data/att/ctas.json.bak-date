 "ce_qui_affaiblirait": [
  "Une autorisation de la FTC sans condition structurelle : le principal risque externe de cette anti-thèse disparaîtrait, et le calendrier de clôture redeviendrait lisible.",
  "La publication par Cintas d'un objectif chiffré de synergies annuelles supérieur à environ 250 M$ : la dilution pro forma du bénéfice par action serait alors compensée sur le papier, et l'argument du prix payé perdrait beaucoup de sa force.",
  "Une croissance organique du segment location d'uniformes qui repasse durablement au-dessus de 9% : l'argument de la décélération du moteur principal tomberait.",
  "Un abandon de l'opération avec paiement des 350 M$ d'indemnité : le bilan resterait celui d'aujourd'hui, quasiment sans levier, et trois des quatre arguments internes deviendraient sans objet.",
  "Une baisse du multiple de valorisation vers la zone des 30 fois le bénéfice sans dégradation des résultats : l'argument de valorisation perdrait sa raison d'être."
 ],
 "glossaire": {
  "S-4*": "Document déposé auprès du régulateur boursier américain quand une société paye une acquisition en actions : il contient le détail du prix et les comptes simulés de l'ensemble.",
  "PRO FORMA*": "Comptes simulés qui montrent ce qu'auraient donné les résultats si l'opération avait déjà eu lieu à la date indiquée.",
  "BÉNÉFICE PAR ACTION*": "Bénéfice net de la société divisé par le nombre d'actions : c'est ce qui revient à une action.",
  "CROISSANCE ORGANIQUE*": "Croissance du chiffre d'affaires hors effet des acquisitions et hors effet des variations de devises, donc la croissance réellement produite par l'activité existante.",
  "SURVALEUR*": "Écart entre le prix payé pour une acquisition et la valeur comptable des actifs rachetés, inscrit à l'actif du bilan sans correspondre à un bien physique.",
  "PRÊT RELAIS*": "Crédit court terme mis en place pour financer immédiatement une acquisition, en attendant un financement définitif.",
  "FTC*": "Federal Trade Commission, l'autorité américaine chargée de vérifier qu'un rapprochement ne réduit pas trop la concurrence.",
  "SECONDE DEMANDE D'INFORMATION*": "Étape de la procédure américaine par laquelle l'autorité de concurrence réclame un dossier complet aux deux sociétés, signe qu'elle examine l'opération en profondeur.",
  "ADMINISTRATEUR INDÉPENDANT*": "Membre du conseil d'administration sans lien de travail ni d'affaires avec la société, censé exercer un contrôle libre sur les dirigeants."
 },
