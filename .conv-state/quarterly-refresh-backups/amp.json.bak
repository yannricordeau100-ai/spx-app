  {
   "title": "Environnement macro\u00e9conomique",
   "category": "financial",
   "severity": 4,
   "score_rationale": "Premiere section de l'Item 1A (Market Risks, ~0-1%) : \"may be materially affected by market fluctuations and by economic and other factors\". Position maximale et langage material pour un gestionnaire d'actifs : 4.",
   "trend": "stable",
   "summary": "Exposition \u00e0 la volatilit\u00e9 financi\u00e8re : taux, change, cr\u00e9dit ou liquidit\u00e9, pouvant affecter la rentabilit\u00e9 et la flexibilit\u00e9.",
   "score": 4
  },
  {
   "title": "Risques op\u00e9rationnels",
   "category": "operational",
   "severity": 2,
   "score_rationale": "Section Operations Risks au milieu de l'Item 1A (~29-46%), langage prudentiel : \"We may not be able to maintain our unaffiliated third-party distribution channels\". Risque generique sans exposition chiffree : 2.",
   "trend": "stable",
   "summary": "Risques op\u00e9rationnels touchant cha\u00eene d'approvisionnement, capital humain, qualit\u00e9 produit ou continuit\u00e9 d'activit\u00e9.",
   "score": 2
  },
  {
   "title": "Risque de taux d'int\u00e9r\u00eat",
   "category": "financial",
   "severity": 3,
   "score_rationale": "Haut de l'Item 1A (~10-14%), risque de spread concret sur les produits assurance : \"we may have to accept a lower spread and thus lower profitability\". Langage conditionnel : 3.",
   "trend": "stable",
   "summary": "Exposition \u00e0 la volatilit\u00e9 financi\u00e8re : taux, change, cr\u00e9dit ou liquidit\u00e9, pouvant affecter la rentabilit\u00e9 et la flexibilit\u00e9.",
   "score": 3
  },
  {
   "title": "Pression concurrentielle",
   "category": "competitive",
   "severity": 2,
   "score_rationale": "Premier tiers de l'Item 1A (~23%) mais formulation generique : \"We face intense competition in attracting and retaining key talent\". Risque boilerplate commun au secteur : 2.",
   "trend": "stable",
   "summary": "Pression concurrentielle accrue, \u00e9rosion potentielle des parts de march\u00e9 et compression des marges face \u00e0 de nouveaux entrants.",
   "score": 2
  },
  {
   "title": "R\u00e9putation et image de marque",
   "category": "regulatory",
   "severity": 3,
   "score_rationale": "Milieu de l'Item 1A (~46%), langage conditionnel standard : \"A failure to protect our reputation could adversely affect our businesses\". Actif cle mais sans incident ni chiffrage : 3.",
   "trend": "stable",
   "summary": "Risques li\u00e9s aux changements normatifs, enqu\u00eates ou contentieux susceptibles d'imposer des sanctions ou de contraindre les op\u00e9rations.",
   "score": 3
  }
