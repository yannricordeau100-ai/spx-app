 "_hero_last_data_date_refreshed_at": "2026-05-28T04:41:31.297003+00:00",
 "tagline_fr": "Leader des puces pour data centers, IA et calcul haute performance.",
 "kpis_signal_fr": {
  "Data Center Rev": "Forte croissance tir\u00e9e par la demande IA et hyperscalers.",
  "HPC / Cloud": "AMD capte la vague IA via la dynamique GPU data center.",
  "Revenue": "Croissance annuelle tr\u00e8s forte de 34%.",
  "Gross Margin": "Marge brute stable et \u00e9lev\u00e9e malgr\u00e9 les charges sur stocks li\u00e9es aux contr\u00f4les d'export.",
  "R&D %": "Investissement R&D significatif pour l'IA, ratio am\u00e9lior\u00e9, le CA cro\u00eet plus vite que la R&D.",
  "Capex / Revenue": "Capex mod\u00e9r\u00e9 refl\u00e9tant le mod\u00e8le fabless avec fabrication externalis\u00e9e."
 },
 "kpis_explanation_fr": {
  "Data Center Rev": "Revenu g\u00e9n\u00e9r\u00e9 par les processeurs et GPU pour data centers, principalement utilis\u00e9s en IA et cloud computing.",
  "HPC / Cloud": "Revenu li\u00e9 au calcul haute performance et aux solutions IA, inclus dans le segment data center et cl\u00e9 pour la croissance future.",
  "Revenue": "Total des ventes r\u00e9alis\u00e9es par AMD sur l'ensemble des segments durant l'exercice.",
  "Gross Margin": "Pourcentage du revenu restant apr\u00e8s d\u00e9duction du co\u00fbt des ventes et amortissement des actifs incorporels li\u00e9s aux acquisitions.",
  "R&D %": "D\u00e9penses de R&D en pourcentage du revenu net, refl\u00e9tant l'investissement dans l'IA et le d\u00e9veloppement de nouveaux produits.",
  "Capex / Revenue": "Ratio des d\u00e9penses d'investissement sur revenu net, refl\u00e9tant les besoins mod\u00e9r\u00e9s en capex du mod\u00e8le fabless."
 },
 "risks_rationale_fr": {
  "0": "Le risque est en haut de la section 'Economic and Strategic Risks' et d\u00e9crit des pressions agressives de prix, de bundling et de partenariats strat\u00e9giques (ex: Nvidia-Intel). Le langage est alarmant ('materially adversely affect', 'reduce our unit sales and average selling prices'). La cat\u00e9gorie 'Concurrence' est critique dans le secteur semi-conducteurs. Risque renforc\u00e9 par un nouveau partenariat en 2025.",
  "1": "Mentionn\u00e9 plusieurs fois dans les segments Data Center et AI, avec un langage fort ('significant demand', 'trajectory is unknown', 'material adverse effect'). La croissance future d\u00e9pend fortement de l'adoption de l'IA g\u00e9n\u00e9rative. La cat\u00e9gorie 'Macro' est hautement pond\u00e9r\u00e9e ici car li\u00e9e \u00e0 une tendance technologique mondiale instable.",
  "2": "Le risque est r\u00e9p\u00e9t\u00e9 plusieurs fois avec un langage fort ('severe downturns', 'substantial losses', 'materially adversely affect'). Historique de pertes document\u00e9. Bien que r\u00e9current, il reste critique en contexte \u00e9conomique incertain. Cat\u00e9gorie 'Macro' fortement pond\u00e9r\u00e9e.",
  "3": "Le risque est central dans 'Operational and Technology Risks'. AMD d\u00e9pend enti\u00e8rement de tiers pour la fabrication. Le langage est fort ('materially adversely affected', 'timely basis', 'competitive technologies'). Une rupture d'approvisionnement ou un retard technologique aurait un impact existentiel.",
  "4": "Mentionn\u00e9 avec un langage alarmant ('disrupt operations', 'compromise IP', 'costly to remediate', 'significant damage'). L'IP est vitale pour AMD. La cat\u00e9gorie 'Cybers\u00e9curit\u00e9' est de plus en plus critique dans le secteur tech. Risque amplifi\u00e9 par la valeur des designs de puces.",
  "5": "Le risque est li\u00e9 \u00e0 la strat\u00e9gie 'Ryzen AI' et \u00e0 la transition du march\u00e9 PC. Langage prudent ('no assurance', 'rate and pace of adoption'). D\u00e9pend de facteurs externes comme les cycles de remplacement. Impact direct sur le segment Client.",
  "6": "Mentionn\u00e9 dans 'Legal and Regulatory Risks' avec un langage ferme ('limit our ability to export'). AMD op\u00e8re mondialement, donc sensible aux tensions g\u00e9opolitiques et restrictions d'export (ex: Chine). Cat\u00e9gorie 'R\u00e9gulation' en hausse d'importance."
 },
 "stories_body_fr": [
  {
   "kpi_short": "Client and Gaming Rev",
   "body_fr": "Le chiffre d'affaires du segment Client et Gaming passe de 9,6 Mds$ en 2024 \u00e0 14,6 Mds$ en 2025, port\u00e9 par la forte demande pour les processeurs Ryzen, les GPU Radeon 9000 et les SoCs pour consoles."
  },
  {
   "kpi_short": "Embedded Rev",
   "body_fr": "Le chiffre d'affaires du segment Embedded recule de 3% \u00e0 3,5 Mds$ en 2025 contre 3,6 Mds$ en 2024, la demande restant mitig\u00e9e sur les march\u00e9s industriels et r\u00e9seaux."
  }
 ],
 "kpis_description_fr": {
  "Data Center Rev": "En 2025, le segment centre de donn\u00e9es a g\u00e9n\u00e9r\u00e9 16,6 milliards $ de chiffre d\u2019affaires, en hausse de 32 % par rapport \u00e0 12,6 milliards $ en 2024, port\u00e9 par une forte demande pour les processeurs AMD EPYC 5e g\u00e9n\u00e9ration et les GPU AMD Instinct MI350 Series.",
  "HPC / Cloud": "Les revenus IA et HPC, composante du segment centre de donn\u00e9es, ont atteint 16,6 milliards $ en 2025, soutenus par les GPU Instinct MI350 Series d\u00e9di\u00e9s aux charges de travail d\u2019IA g\u00e9n\u00e9rative.",
  "Revenue": "Le chiffre d\u2019affaires net total a atteint 34,6 milliards $ en 2025, contre 25,8 milliards $ en 2024, soit une croissance annuelle de 34 % tir\u00e9e par les segments centre de donn\u00e9es et client/jeu.",
  "Gross Margin": "La marge brute est pass\u00e9e \u00e0 50,0 % en 2025 contre 49,3 % en 2024, principalement gr\u00e2ce \u00e0 un mix produit favorable, partiellement compens\u00e9e par environ 440 millions $ de charges nettes d\u2019inventaire li\u00e9es aux contr\u00f4les d\u2019exportation am\u00e9ricains sur les GPU AMD Instinct MI308 Data Center.",
  "R&D %": "Les d\u00e9penses de R&D ont atteint 8,091 milliards $ en 2025, soit 23,4 % du chiffre d\u2019affaires net, contre 6,456 milliards $ ou 25,0 % en 2024, refl\u00e9tant un investissement ma\u00eetris\u00e9 dans l\u2019IA et les feuilles de route produit, le revenu croissant d\u00e9passant l\u2019augmentation des d\u00e9penses R&D.",
  "Capex / Revenue": "Les d\u00e9penses d'investissement ont totalis\u00e9 974 M$ en 2025, soit 2,8 % du chiffre d'affaires net, contre 645 M$ ou 2,5 % en 2024, soutenant l'expansion de capacit\u00e9 et les investissements d'infrastructure."
 },
