  "risks": [
    {
      "category": "Market/Operational",
      "name": "Performance of European building construction industry",
      "description": "Geberit exposed to fluctuations in building construction activity, particularly in Europe. Renovations less cyclical than new construction. Inventory rebuilding/destocking at wholesalers can impact short-term sales.",
      "severity": 3,
      "trend": "stable",
      "rationale": "Renovations account for ~60% of sales, providing stability. Long-term technology penetration opportunity exists.",
      "source_doc_year": "annual_2024"
    },
    {
      "category": "Operational",
      "name": "Availability of materials",
      "description": "Supply chain disruption risk for raw materials and components needed for production.",
      "severity": 2,
      "trend": "improving",
      "rationale": "2024 saw normalisation of global supply chains, good availability, return to normal delivery times. Prudent procurement strategy and regional orientation in place.",
      "source_doc_year": "annual_2024"
    },
    {
      "category": "Market",
      "name": "Changes in competitive environment",
      "description": "Risk from competitive pressures in sanitary products market.",
      "severity": 2,
      "trend": "stable",
      "rationale": "Geberit has comprehensive product range, innovative products, strong partnerships with craft sector, wholesalers and investors.",
      "source_doc_year": "annual_2024"
    },
    {
      "category": "Cyber/IT",
      "name": "IT security",
      "description": "Cybersecurity threats including cyberattacks and business continuity risks.",
      "severity": 3,
      "trend": "managed",
      "rationale": "IT security committee in place, regular training for Group Executive Board with hacker attack simulations, regular security checks with external specialists confirm good security level. Geberit at least on par with similar size/complexity industrial companies.",
      "source_doc_year": "annual_2024"
    },
    {
      "category": "Regulatory/Legal",
      "name": "Compliance with laws",
      "description": "Legal risks from normal business activity, regulatory compliance exposure.",
      "severity": 2,
      "trend": "managed",
      "rationale": "Comprehensive compliance processes in place to prevent violations.",
      "source_doc_year": "annual_2024"
    },
    {
      "category": "Financial",
      "name": "Currency risks",
      "description": "Foreign exchange exposure from multinational operations, particularly EUR/CHF fluctuations.",
      "severity": 3,
      "trend": "stable",
      "maturation": "Managed through natural hedging strategy matching costs to revenues by currency area",
      "sensitivity": "10% CHF movement impacts: Net sales +/-9%, EBITDA +/-9%, EBITDA margin +/-0pp",
      "rationale": "Natural hedging limits impact on operating margins. Translation effects are main source of FX impact.",
      "source_doc_year": "annual_2024"
    },
