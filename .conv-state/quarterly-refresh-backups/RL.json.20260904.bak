 "risks": [
  {
   "title": "Tensions commerciales et guerre des tarifs",
   "category": "Macro",
   "severity": 5,
   "score_rationale": "Le risque est placé en tête des facteurs macroéconomiques, avec un langage fort sur l'incertitude, la volatilité des marchés et la menace de récession. Il est renforcé par des mentions répétées de tarifs sur la Chine, le Vietnam et le Cambodge, et des réponses de rétorsion. Catégorie Macro très pondérée. Citation: \"=== RL_2025-05-22.htm.gz === Item 1A 'Risk Factors Risks Related to Citizenship and Sustainability Issues.' Recent\". Position: haut Item 1A.",
   "trend": "up",
   "summary": "L'augmentation des tarifs douaniers et les tensions commerciales menacent la rentabilité et la chaîne d'approvisionnement.",
   "score": 5
  },
  {
   "title": "Récession mondiale et ralentissement de la consommation",
   "category": "Macro",
   "severity": 5,
   "score_rationale": "Langage alarmant sur la récession potentielle, la baisse du pouvoir d'achat et la chute de la demande de produits de luxe. Position centrale dans le 10-K et intensité accrue vs N-1. Catégorie Macro critique. Citation: \"Our Wholesale Business Our wholesale business sells our products globally primarily to major department stores\". Position: bas Item 1A.",
   "trend": "up",
   "summary": "Un ralentissement économique global réduit la demande pour les produits haut de gamme et affecte les ventes.",
   "score": 5
  },
  {
   "title": "Conflits géopolitiques et instabilité mondiale",
   "category": "Géopolitique",
   "severity": 4,
   "score_rationale": "Mentions spécifiques aux guerres en Ukraine et au Moyen-Orient, perturbations dans la mer Rouge, hausse des coûts logistiques. Langage préoccupé mais impact actuel jugé limité. Catégorie Géopolitique moyennement pondérée. Citation: \"In addition, our licensing partners may be required to allocate a portion of their revenues\". Position: bas Item 1A.",
   "trend": "up",
   "summary": "Les conflits militaires perturbent les chaînes logistiques et augmentent les coûts énergétiques et de transport.",
   "score": 4
  },
  {
   "title": "Fluctuations des devises étrangères",
   "category": "Macro",
   "severity": 4,
   "score_rationale": "Exposition majeure à l'euro, yen, yuan, etc., avec impact direct sur les coûts d'importation et les marges. Le texte souligne l'inefficacité partielle des couvertures. Catégorie Macro fortement pondérée. Citation: \"We continue to expand accessibility to our digital flagships globally while localizing language, currencies, payment\". Position: milieu Item 1A.",
   "trend": "stable",
   "summary": "Les variations des taux de change affectent les marges et les revenus, malgré des stratégies de couverture.",
   "score": 4
  },
  {
   "title": "Pandémies et crises sanitaires",
   "category": "Macro",
   "severity": 4,
   "score_rationale": "Liste exhaustive d'impacts (chaîne d'approvisionnement, fermetures, comportements). Langage très détaillé et répété, avec référence au COVID-19. Catégorie Macro élevée. Citation: \"We continue to expand accessibility to our digital flagships globally while localizing language, currencies, payment\". Position: milieu Item 1A.",
   "trend": "stable",
   "summary": "Les épidémies peuvent paralyser la production, réduire la fréquentation en magasin et bouleverser la demande.",
   "score": 4
  },
  {
   "title": "Dépendance à la liquidité des tiers",
   "category": "Crédit",
   "severity": 4,
   "score_rationale": "Risque clairement identifié sur la solvabilité des clients, fournisseurs et banques. Mention de dépôts non assurés et de crise bancaire possible. Catégorie Crédit modérément pondérée. Citation: \"No operating segments were aggregated to form our reportable segments\". Position: milieu Item 1A.",
   "trend": "up",
   "summary": "La défaillance d'un partenaire clé ou d'une banque pourrait nuire à la trésorerie et aux opérations.",
   "score": 4
  },
  {
   "title": "Difficultés dans l'exécution de la stratégie de croissance",
   "category": "Stratégie",
   "severity": 4,
   "score_rationale": "Le risque est central dans la section 'Strategic Initiatives', avec mise en garde sur les investissements coûteux et les délais. Langage prudent mais répété. Catégorie Industriel retenue par analogie. Citation: \"This segment structure is consistent with how we establish our overall business strategy, allocate resources\". Position: milieu Item 1A.",
   "trend": "stable",
   "summary": "L'échec à déployer efficacement la stratégie de croissance pourrait nuire à la rentabilité et à la compétitivité.",
   "score": 4
  }
 ],
