  "ai_positioning_fr": {
    "summary_fr": "Palo Alto Networks place l'intelligence artificielle et l'automation au cœur de sa stratégie de cybersécurité. La société intègre l'IA dans ses principales plateformes: Prisma AIRS pour la protection des écosystèmes IA, Cortex pour les opérations de sécurité, et Strata Cloud Manager qui utilise l'IA pour simplifier la gestion. L'acquisition de Protect AI en juillet 2025 et l'accord d'acquisition de CyberArk confirment l'engagement de la société envers l'innovation en matière de sécurité IA.",
    "evidence_fr": [
      {
        "text_fr": "Prisma AIRS: plateforme de sécurité IA complète pour la protection des modèles IA, la gestion des postures, les tests de résistance, la sécurité à l'exécution et la sécurité des agents IA",
        "source": "Prisma AIRS: plateforme de sécurité IA complète pour la protection des modèles IA, la gestion des postures, les tests de résistance, la sécurité à l'exécution et la sécurité des agents IA"
      },
      {
        "text_fr": "Cortex XSIAM 3.0: remplacement des outils SIEM traditionnels par une solution alimentée par l'IA",
        "source": "Cortex XSIAM 3.0: remplacement des outils SIEM traditionnels par une solution alimentée par l'IA"
      },
      {
        "text_fr": "Strata Cloud Manager avec Strata Copilot: interface en langage naturel alimentée par l'IA pour les recommandations de sécurité",
        "source": "Strata Cloud Manager avec Strata Copilot: interface en langage naturel alimentée par l'IA pour les recommandations de sécurité"
      },
      {
        "text_fr": "Acquisition de Protect AI (juillet 2025) pour renforcer les capacités de la plateforme de sécurité IA",
        "source": "Acquisition de Protect AI (juillet 2025) pour renforcer les capacités de la plateforme de sécurité IA"
