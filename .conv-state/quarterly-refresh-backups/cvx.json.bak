 "risks": [
  {
   "title": "Volatilité des prix du pétrole, gaz et NGL",
   "category": "Marché",
   "severity": 5,
   "score_rationale": "Risque placé en tête des Business and Operational Risk Factors. Le 10-K détaille explicitement l'impact d'une baisse prolongée des prix sur les résultats upstream, les flux de trésorerie, les programmes d'investissement et les réserves.",
   "trend": "stable",
   "summary": "Une baisse durable des prix du brut et du gaz réduit massivement les revenus et la capacité d'investissement de Chevron.",
   "score": 5
  },
  {
   "title": "Réglementation climatique et transition énergétique",
   "category": "Climat",
   "severity": 5,
   "score_rationale": "Section dédiée très détaillée sur la législation GHG, IRA, Paris Agreement. Chevron est exposée à une potentielle réduction structurelle de la demande d'hydrocarbures et à des coûts de compliance croissants.",
   "trend": "up",
   "summary": "L'accélération de la transition énergétique et les nouvelles règles GHG menacent la demande long terme d'hydrocarbures et augmentent les coûts de Chevron.",
   "score": 5
  },
  {
   "title": "Cyberattaques sur les technologies opérationnelles",
   "category": "Cybersécurité",
   "severity": 4,
   "score_rationale": "Section dédiée explicite sur les cyberattaques visant les systèmes OT et IT. Chevron mentionne avoir déjà subi des incidents et continue à en subir. Précédent Colonial Pipeline US 2021 dans le secteur.",
   "trend": "up",
   "summary": "Une cyberattaque réussie sur les systèmes opérationnels Chevron pourrait stopper la production et causer des dommages environnementaux majeurs.",
   "score": 4
  },
  {
   "title": "Acquisition de Hess et résolution de l'arbitrage Stabroek (ExxonMobil)",
   "category": "Stratégique",
   "severity": 5,
   "score_rationale": "Section dédiée explicite sur l'acquisition pendante de Hess. La résolution de l'arbitrage sur le droit de préemption (ROFR) Stabroek avec ExxonMobil est critique. Décision attendue 2025. Échec entraînerait l'abandon de la fusion.",
   "trend": "up",
   "summary": "Un échec de l'arbitrage Stabroek avec ExxonMobil ferait capoter l'acquisition de Hess et priverait Chevron de ses actifs guyanais.",
   "score": 5
  },
  {
   "title": "Risques opérationnels inhérents (hazards, sécurité)",
   "category": "Industriel",
   "severity": 4,
   "score_rationale": "Section dédiée sur les hazards opérationnels du secteur énergétique. Risque d'incidents majeurs (explosions, rejets, pertes humaines) avec exposition légale et environnementale.",
   "trend": "stable",
   "summary": "Les hazards inhérents à l'industrie pétrolière (explosions, fuites, accidents) peuvent générer des pertes humaines, environnementales et financières majeures.",
   "score": 4
  },
  {
   "title": "Instabilité politique dans les pays d'opération",
   "category": "Géopolitique",
   "severity": 4,
   "score_rationale": "Section dédiée sur l'instabilité politique. Chevron opère au Venezuela, Kazakhstan, Nigeria, Angola, Guyana. Mentions explicites de sanctions Venezuela et Russie.",
   "trend": "up",
   "summary": "Les sanctions Venezuela, Russie et l'instabilité dans les pays producteurs peuvent restreindre la production et les rapatriements de cash de Chevron.",
   "score": 4
  }
 ],
