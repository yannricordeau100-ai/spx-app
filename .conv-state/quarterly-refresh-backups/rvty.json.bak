 "ticker": "RVTY",
 "risks": [
  {
   "title": "Dépendance aux financements publics et marchés pharma/biotech",
   "category": "strategic",
   "severity": 4,
   "score_rationale": "Revolution & Diagnostics dépend des budgets NIH, financements biotech early-stage et capex pharma. Slowdown funding 2023-2024 a déjà pesé sur Life Sciences. Item 1A insiste sur volatilité ces cycles.",
   "trend": "stable",
   "summary": "La demande de RVTY dépend des budgets publics de recherche et de l'investissement biotech, sensibles aux cycles de financement.",
   "score": 4
  },
  {
   "title": "Concentration manufacturing et chaîne d'approvisionnement complexe",
   "category": "operational",
   "severity": 4,
   "score_rationale": "Sites de production critiques en Finlande, Suède, Singapour et Chine. Composants spécialisés (réactifs, optique) à sources uniques. Item 1A langage fort sur impact rupture.",
   "trend": "stable",
   "summary": "RVTY dépend de sites manufacturing concentrés et de composants à fournisseur unique, exposés aux disruptions logistiques.",
   "score": 4
  },
  {
   "title": "Intégration post-cession EUROIMMUN et reshape portefeuille",
   "category": "strategic",
   "severity": 4,
   "score_rationale": "Spin-off Applied/Analytical 2023 + cession activités diagnostic 2024 ont transformé le périmètre. Risques d'exécution et de synergies non réalisées documentés.",
   "trend": "down",
   "summary": "La transformation post-cession diagnostic et focus pure-play Life Sciences crée des risques d'exécution et de perte de revenus stranded.",
   "score": 4
  },
  {
   "title": "Régulation médicale FDA, EU MDR/IVDR et CE marking",
   "category": "regulatory",
   "severity": 4,
   "score_rationale": "Produits diagnostiques soumis à IVDR EU (transition compliance 2027) et FDA 510(k)/PMA. Coût compliance hausse structurelle. Item 1A explicite.",
   "trend": "up",
   "summary": "Les exigences réglementaires FDA et EU IVDR/MDR augmentent les coûts de mise en conformité et retardent les lancements produits.",
   "score": 4
  },
  {
   "title": "Cybersécurité sur instruments connectés et données patients",
   "category": "technological",
   "severity": 3,
   "score_rationale": "Instruments connectés cloud + données génomiques sensibles HIPAA/GDPR. Risque ransomware sur clients hôpitaux remonte.",
   "trend": "up",
   "summary": "Les instruments connectés et les données patients exposent RVTY à des cyberattaques sur ses systèmes et ceux de ses clients.",
   "score": 3
  },
  {
   "title": "Exposition Chine et tensions géopolitiques sur Life Sciences",
   "category": "regulatory",
   "severity": 4,
   "score_rationale": "Chine ~10-12% revenus. BIOSECURE Act US et contrôles export instruments scientifiques menacent accès marché. Slowdown économique chinois pèse 2024.",
   "trend": "up",
   "summary": "L'exposition Chine et les contrôles export US sur les instruments scientifiques menacent la croissance Life Sciences de RVTY.",
   "score": 4
  }
 ],
