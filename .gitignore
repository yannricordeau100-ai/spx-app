# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# environment variables
.env.local
.env*.local

# SEC filings cache (locally downloaded, large) — symlink + dir variants
sec-data
sec-data/
backups/

# Pipeline LLM caches (huge, regenerable)
.pipeline-cache/
.pipeline-doc-cache/

# Python bytecode
__pycache__/
*.pyc

# IDE / Cursor
.cursor/
.vscode/

# Cleanup commit d105e4ce (Yann 18 mai 2026) - fichiers parasites
.claude/worktrees/
.conv-state/*.log
.ir-scrape-cache/
.popular-stocks-cache.json
_bulk-transcripts-*.log
src/data/companies/
public/logos/.backup-*
public/logos/*.batch4-bak

# PDF sources >100 Mo (limite GitHub), conserves en local uniquement
data-lake/LULU/EP/LULU_2022-04-20_EP.pdf
data-lake/LULU/EP/LULU_2024-10-10_EP.pdf

# 1er aout 2026 (chaine CAC 40) : les PDF sources des sociétés Euronext
# restent en local. 2,9 Go qui font echouer le push HTTP (408) et alourdissent
# chaque build. Les .txt.gz extraits, eux, sont versionnes et suffisent a
# retracer toute valeur publiee.
data-lake/*.PA/ir/**/*.pdf
data-lake/MT.AS/ir/**/*.pdf
