  "stories_kpis": [
    {
      "short": "ai_pc_mix",
      "name_fr": "Part des PC IA dans les livraisons",
      "value": 46,
      "unit": "%",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 46
        }
      ],
      "story_fr": "Près d'un PC livré par HP sur deux est un PC IA. HP vise 50 % en fin d'exercice, puis 60 à 70 % en 2027.",
      "story_en": "",
      "signal": "PC IA proches de la moitié des volumes",
      "category": "Adoption",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "AI PCs were a strong performance also for us this quarter. It contributed 46% of our mix, in line with our 40% to 50% forecast for FY '26.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "key_growth_areas_growth",
      "name_fr": "Croissance des relais de croissance",
      "value": 46,
      "unit": "%",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 46
        }
      ],
      "story_fr": "Les activités jugées prioritaires (PC IA, calcul avancé, Workforce Solutions, impression industrielle) croissent de 46 % sur un an, bien plus vite que le reste du groupe.",
      "story_en": "",
      "signal": "Relais de croissance en forte hausse",
      "category": "Marché",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "We executed on our commitments and accelerated our key growth areas, which collectively grew 46% year-over-year and faster than our core.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "tank_printer_units_growth",
      "name_fr": "Croissance des volumes d'imprimantes à réservoir",
      "value": 42,
      "unit": "%",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 42
        }
      ],
      "story_fr": "Les ventes d'imprimantes à réservoir d'encre progressent de 42 % en unités, alors que le volume total d'imprimantes recule. HP y encaisse la marge dès la vente du matériel.",
      "story_en": "",
      "signal": "Réservoirs en forte hausse",
      "category": "Marché",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "we continue to increase our penetration of the tank printer market, delivering 42% unit growth in this important profit upfront category",
      "_source_date": "2026-09-14"
    },
    {
      "short": "big_tank_share_gain",
      "name_fr": "Gain de part de marché imprimantes à réservoir",
      "value": 4,
      "unit": "pts",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 4
        }
      ],
      "story_fr": "HP gagne encore 4 points de part de marché sur les imprimantes à grand réservoir, un segment où il avait promis d'accélérer.",
      "story_en": "",
      "signal": "Gain de part sur les réservoirs",
      "category": "Marché",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "We said we would double down on big tank market, and we did, gaining another 4 points of share this quarter.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "premium_pc_share_gain",
      "name_fr": "Gain de part de marché PC premium",
      "value": 2.6,
      "unit": "pts",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 2.6
        }
      ],
      "story_fr": "HP gagne 2,6 points de part de marché sur les PC haut de gamme d'un trimestre à l'autre, ce qui le ramène en tête sur la zone Amériques.",
      "story_en": "",
      "signal": "Gain de part sur le premium",
      "category": "Marché",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "We grew 2.6 points of share on premium and 1.8 points of share on workstations.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "workstation_share_gain",
      "name_fr": "Gain de part de marché stations de travail",
      "value": 1.8,
      "unit": "pts",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 1.8
        }
      ],
      "story_fr": "HP gagne 1,8 point de part de marché sur les stations de travail, une catégorie portée par les usages d'IA en local.",
      "story_en": "",
      "signal": "Gain de part sur les stations de travail",
      "category": "Marché",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "We grew 2.6 points of share on premium and 1.8 points of share on workstations.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "win11_refresh_complete",
      "name_fr": "Avancement du renouvellement Windows 11",
      "value": 70,
      "unit": "%",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 70
        }
      ],
      "story_fr": "Environ 70 % du cycle de renouvellement lié à Windows 11 est achevé. La demande repose de plus en plus sur les PC IA et les usages d'agents.",
      "story_en": "",
      "signal": "Relais Windows 11 en fin de course",
      "category": "Adoption",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "We now see roughly 70% of the Win 11 refresh complete.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "ai_pc_isv_partners",
      "name_fr": "Éditeurs de logiciels partenaires des PC IA",
      "value": 150,
      "unit": "éditeurs",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 150
        }
      ],
      "story_fr": "Plus de 150 éditeurs de logiciels adaptent leurs applications aux capacités des PC IA d'HP, ce qui en élargit les usages.",
      "story_en": "",
      "signal": "Écosystème logiciel IA étoffé",
      "category": "Innovation",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "the work which we have accelerated with ISV partners, the software companies with more than 150 of them to leverage the capabilities of these PCs",
      "_source_date": "2026-09-14"
    },
    {
      "short": "precise_print_countries",
      "name_fr": "Pays couverts par Precise Print",
      "value": 150,
      "unit": "pays",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 150
        }
      ],
      "story_fr": "L'impression assistée par IA Precise Print est disponible dans plus de 150 pays depuis juin. Elle réduit jusqu'à 38 % le papier et 47 % l'encre consommés.",
      "story_en": "",
      "signal": "IA déployée dans l'impression",
      "category": "Innovation",
      "is_short_history": true,
      "_source": "transcript",
      "_citation": "In June, we expanded our flagship AI-powered Print experience, Precise Print, to more than 150 countries.",
      "_source_date": "2026-09-14"
    },
    {
      "short": "industrial_print_growth_streak",
      "name_fr": "Trimestres consécutifs de croissance de l'impression industrielle",
      "value": 12,
      "unit": "trimestres",
      "history": [
        {
          "q": "Q3-FY2026",
          "v": 12
        }
      ],
