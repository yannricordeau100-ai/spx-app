  "risks": [
    {
      "title": "Dépendance aux locataires retail et défaillances de tenants ancre",
      "category": "operational",
      "severity": 4,
      "score_rationale": "Premiers risques de l'Item 1A : \"net income depends on the success and continued presence of our anchor tenants\". Position en tete, coeur du modele (loyers retail), langage direct \"will adversely affect\" : 4/5.",
      "trend": "stable",
      "summary": "La faillite d'un tenant ancre dans les centres FRT peut entraîner des terminaisons en cascade et une chute des loyers.",
      "score": 4
    },
    {
      "title": "Glissement du retail brick-and-mortar vers le e-commerce",
      "category": "strategic",
      "severity": 2,
      "score_rationale": "Item 1A (~5%, 3e risque) : \"This risk is partially mitigated by our strategy of maintaining a diverse portfolio\". La ste presente elle-meme ce risque comme attenue par son portefeuille : 2/5.",
      "trend": "up",
      "summary": "Le e-commerce continue de réduire la demande de surfaces commerciales physiques, malgré la stratégie de FRT axée sur les zones urbaines à forte densité.",
      "score": 2
    },
    {
      "title": "Concentration géographique et exposition aux marchés locaux",
      "category": "operational",
      "severity": 3,
      "score_rationale": "Item 1A (~7%, haut de section) : \"may have a magnified adverse effect on our portfolio\". Concentration sur 14 Etats et DC avec langage \"material adverse effect\" mais sans exposition chiffree par marche : 3/5.",
      "trend": "stable",
      "summary": "Le portefeuille FRT est concentré géographiquement, amplifiant l'impact d'un ralentissement économique dans ses marchés clés.",
      "score": 3
    },
    {
      "title": "Endettement de 5 Md$ et exposition aux taux variables",
      "category": "financial",
      "severity": 3,
      "score_rationale": "Item 1A (~55%, bloc Funding Strategies) : \"we had approximately $5.0 billion of debt outstanding\". Dette chiffree mais 82.6% a taux fixe ou couverte, langage conditionnel standard : 3/5.",
      "trend": "up",
      "summary": "L'endettement élevé et l'exposition aux taux variables menacent la flexibilité financière en cas de hausse durable des taux.",
      "score": 3
    },
    {
      "title": "Qualification REIT et obligation de distribution 90%",
      "category": "regulatory",
      "severity": 2,
      "score_rationale": "Item 1A (~75%, bloc REIT Status) : \"we cannot assure you that we will remain qualified as such\". Risque technique boilerplate commun a tous les REIT, langage prudentiel : 2/5.",
      "trend": "stable",
      "summary": "Le maintien du statut REIT impose des contraintes strictes; toute perte de qualification générerait une charge fiscale massive.",
      "score": 2
    },
    {
      "title": "Cyberattaques sur systèmes IT et tiers",
      "category": "technological",
      "severity": 2,
      "score_rationale": "Item 1A (~98%, dernier risque de la section) : \"no guarantee such efforts will be successful in preventing a material cybersecurity incident\". Fin de liste, formulation generique : 2/5.",
      "trend": "up",
      "summary": "Les cyberattaques sur les systèmes FRT et ses prestataires peuvent compromettre la collecte des loyers et les obligations financières.",
      "score": 2
    },
    {
      "title": "Risques liés au climat et augmentation des sinistres assurantiels",
      "category": "climate",
      "severity": 2,
      "score_rationale": "Item 1A (~45%) : \"could have an adverse impact on our cash flow and operating results\". Risque climat et catastrophes naturelles generique, langage conditionnel sans chiffrage : 2/5.",
      "trend": "up",
      "summary": "Le réchauffement augmente les coûts d'assurance et les sinistres physiques sur le portefeuille de FRT.",
      "score": 2
    }
  ],
