{
  "ticker": "ASML",
  "risks": [
    {
      "title": "Restrictions à l'exportation vers la Chine",
      "category": "Géopolitique",
      "severity": 5,
      "score_rationale": "Position de tête. ASML doit obtenir licences néerlandaises pour exporter ses litho DUV et EUV. Les restrictions US/NL/JP sur la Chine impactent directement les ventes (>30% historiquement vers la Chine). Tendance up avec extensions 2023-2025. Catégorie Géopolitique pondérée maximale.",
      "trend": "up",
      "summary": "ASML ne peut plus exporter ses machines les plus avancées vers la Chine. La part du marché chinois, jusqu'ici clé, baisse fortement.",
      "score": 5
    },
    {
      "title": "Concentration clients sur TSMC, Samsung, Intel",
      "category": "Concentration",
      "severity": 5,
      "score_rationale": "Annual Report souligne que trois clients (TSMC, Samsung, Intel) représentent la majorité des commandes EUV. Tout report de capex (cas Intel 2024) ou perte de leadership a un impact massif. Tendance stable mais structurelle.",
      "trend": "stable",
      "summary": "ASML vend ses EUV à 3 clients : TSMC, Samsung, Intel. Tout report d'investissement (comme Intel en 2024) fait chuter les commandes.",
      "score": 5
    },
    {
      "title": "Cyclicalité des investissements semi-conducteurs",
      "category": "Marché",
      "severity": 4,
      "score_rationale": "Annual Report développe les cycles de capex semi. Demande mémoire et logique très cyclique. ASML reste vulnérable aux ralentissements (2023-2024 sur DRAM/NAND). Tendance variable mais récurrente.",
      "trend": "stable",
      "summary": "Le marché des semi-conducteurs est cyclique. Une baisse des investissements chez les mémoires ou logiques fait chuter les commandes ASML.",
      "score": 4
    },
    {
      "title": "Innovation et roadmap High-NA EUV",
      "category": "Technologie",
      "severity": 4,
      "score_rationale": "Annual Report détaille les enjeux du High-NA EUV (>€300 M par machine) et la nécessité d'une adoption client. Retard de développement ou échec d'adoption serait matériel. Tendance up avec premières livraisons 2024-2025.",
      "trend": "up",
      "summary": "ASML investit dans le High-NA EUV, machines de nouvelle génération. Retard de développement ou faible adoption client coûteraient cher.",
      "score": 4
    },
    {
      "title": "Chaîne d'approvisionnement complexe et fournisseurs uniques",
      "category": "Industriel",
      "severity": 4,
      "score_rationale": "Annual Report mentionne Zeiss SMT (optiques EUV, fournisseur unique), Trumpf (lasers), Cymer. Toute disruption serait critique. Catégorie Industriel pondérée haut.",
      "trend": "stable",
      "summary": "ASML dépend de fournisseurs uniques (Zeiss pour les optiques, Trumpf pour les lasers). Une rupture chez l'un d'eux bloquerait la production.",
      "score": 4
    }
  ],
