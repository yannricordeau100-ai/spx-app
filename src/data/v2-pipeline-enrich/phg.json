  "risks": [
    {
      "title": "Litiges et passifs Philips Respironics CPAP/BiPAP",
      "category": "operational",
      "severity": 5,
      "score_rationale": "Position #1 systématique depuis 2021 (1). Langage très intense: 'material adverse impact on financial position' avec provisions cumulées >1.5 Mds € et US DOJ consent decree 2024 (2). Risque qui reste très élevé même après le règlement personal injury de 1.1 Mds USD 2024 (3). Catégorie opérationnelle pondérée maximale (4).",
      "trend": "stable",
      "summary": "Le rappel massif des appareils CPAP/BiPAP Respironics (mousse insonorisante) reste un passif majeur : consent decree US bloque la commercialisation, restant des class actions et risque économique des plaintes individuelles."
    },
    {
      "title": "Tarifs douaniers et pression coûts inflation",
      "category": "macro",
      "severity": 4,
      "score_rationale": "Position #2 dans Q1 2026 (1). Langage fort: 'higher tariffs and cost inflation' explicitement cité (2). Risque aggravé vs N-1 par l'extension des tariffs US 2025-2026 sur les medical devices (3). Catégorie macro pondérée fortement (4).",
      "trend": "up",
      "summary": "Les nouveaux tarifs US sur les dispositifs médicaux importés et l'inflation des coûts de production rognent la marge Adjusted EBITA, malgré les plans de productivité affichés."
    },
    {
      "title": "Risque cyber et sécurité des dispositifs médicaux connectés",
      "category": "cyber",
      "severity": 4,
      "score_rationale": "Position #3-4 (1). Langage fort: 'cybersecurity incident on connected medical devices' (2). Risque aggravé vs N-1 par la régulation FDA cybersecurity pre-market 2023 et NIS2 EU (3). Catégorie cyber pondérée maximale (4).",
      "trend": "up",
      "summary": "L'écosystème Philips (Azurion, DeviceGuide, SmartHeart) repose sur des dispositifs connectés AI : toute faille cyber peut entraîner rappels, amendes FDA et perte de confiance hôpitaux."
    },
    {
      "title": "Concurrence intense MedTech (Siemens Healthineers, GE HealthCare)",
      "category": "competitive",
      "severity": 4,
      "score_rationale": "Position #4-5 (1). Langage modéré-fort: 'intense competition in MedTech' (2). Risque stable mais aggravé par l'investissement IA de GEHC et Siemens (3). Catégorie concurrence pondérée moyenne mais avec impact direct sur growth (4).",
      "trend": "stable",
      "summary": "Diagnosis & Treatment fait face à Siemens Healthineers et GE HealthCare dans l'imagerie, avec une croissance comparable Q1 2026 à seulement +2%, signal d'une concurrence qui rogne les parts de marché."
    },
    {
      "title": "Régulation FDA et accès au marché chinois",
      "category": "regulatory",
      "severity": 3,
      "score_rationale": "Position #6+ (1). Langage modéré: 'regulatory approvals required for new launches' (2). Risque aggravé vs N-1 par la difficulté de Philips à retrouver son accès complet sur Respironics US (3). Catégorie réglementaire pondérée moyenne (4).",
      "trend": "stable",
      "summary": "L'obtention de clearances FDA 510(k) (DeviceGuide, SmartHeart, Verida, Rembra) reste critique, et l'accès au marché chinois (anti-corruption healthcare, volume-based procurement) limite la croissance International."
    }
  ],
