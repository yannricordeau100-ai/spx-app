 "risks": [
  {
   "title": "Risques liés aux contrôles d'exportation et aux tarifs commerciaux",
   "category": "Géopolitique",
   "severity": 4,
   "score_rationale": "Citation 10-K : \"would likely harm our business, financial condition and results of operations\". Premier tiers de l'Item 1A, risque longuement developpe avec faits concrets (restriction BIS mai-juillet 2025 ayant reduit le revenu Chine, Entity List). Langage fort et exposition reelle mais pas de part de CA chiffree >30%, donc 4/5 et non 5/5.",
   "trend": "up",
   "summary": "Les restrictions d'exportation américaines sur les technologies EDA en Chine et les tarifs commerciaux potentiels présentent un risque important pour les revenus internationaux et la chaîne d'approvisionnement.",
   "score": 4
  },
  {
   "title": "Dépendance à l'égard des secteurs des semi-conducteurs et de l'électronique",
   "category": "Marché",
   "severity": 3,
   "score_rationale": "Citation 10-K : \"demand for our products and services could decrease\". Haut de l'Item 1A (2e risque developpe), mais langage conditionnel standard (\"could be adversely affected\") sans exposition chiffree alarmante : 3/5.",
   "trend": "stable",
   "summary": "L'exposition principale aux cycles de l'industrie des semi-conducteurs crée une vulnérabilité aux ralentissements économiques et aux changements dans la demande de puces.",
   "score": 3
  },
  {
   "title": "Timing et reconnaissance des revenus",
   "category": "Opérationnel",
   "severity": 3,
   "score_rationale": "Citation 10-K : \"affected by the timing of revenue recognition\". Tout premier risque developpe de l'Item 1A, mais langage prudentiel classique (\"would have an adverse effect\") et sujet mecanique comptable sans exposition chiffree : 3/5.",
   "trend": "stable",
   "summary": "La variabilité du timing de reconnaissance des revenus crée une volatilité dans les résultats opérationnels entre les périodes fiscales.",
   "score": 3
  },
  {
   "title": "Risques d'intégration des acquisitions",
   "category": "Opérationnel",
   "severity": 3,
   "score_rationale": "Citation 10-K : \"could prove difficult to integrate, disrupt our business, dilute stockholder value\". Premier tiers de l'Item 1A, liste type de risques d'acquisition en langage conditionnel (\"could harm\"), pas de chiffre d'exposition : 3/5.",
   "trend": "up",
   "summary": "Les acquisitions multiples présentent des risques d'intégration, de perte de synergies et de dilution actionnariale.",
   "score": 3
  },
  {
   "title": "Protection de la propriété intellectuelle",
   "category": "Légal",
   "severity": 3,
   "score_rationale": "Citation 10-K : \"cannot assure that the precautions taken to protect our rights will be adequate\". Premier tiers de l'Item 1A, langage conditionnel (\"could seriously harm\") habituel du secteur logiciel, sans exposition chiffree : 3/5.",
   "trend": "stable",
   "summary": "La dépendance envers la protection des droits de propriété intellectuelle expose l'entreprise aux risques de violation et de concurrence non autorisée.",
   "score": 3
  },
  {
   "title": "Violations de contrôle des exportations antérieures et obligations de conformité",
   "category": "Compliance",
   "severity": 4,
   "score_rationale": "Citation 10-K : \"aggregate net penalties and forfeitures of $140.6 million\". Premier tiers de l'Item 1A, risque tres developpe et chiffre (plaider-coupable DOJ, probation 3 ans, audits BIS annuels), langage fort \"could materially and adversely affect\" : 4/5.",
   "trend": "stable",
   "summary": "Les obligations de conformité permanentes et le risque de futurs contrôles de conformité liés aux violations passées pourraient entraîner des amendes supplémentaires ou des limitations.",
   "score": 4
  },
  {
   "title": "Concurrence accrue dans l'industrie de la conception électronique",
   "category": "Concurrence",
   "severity": 3,
   "score_rationale": "Citation 10-K : \"competition in our industries is substantial\". Section situee au milieu de l'Item 1A (bloc Customers, Suppliers and Industry Competition), langage conditionnel (\"may not be able to continue to compete successfully\"), sans chiffre : 3/5.",
   "trend": "stable",
   "summary": "La concurrence croissante dans l'industrie des technologies de conception de puces pourrait impacter la part de marché et les marges.",
   "score": 3
  }
 ],
