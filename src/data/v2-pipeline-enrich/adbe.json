  "risks_rationale_fr": {
    "0": "Risque positionné en début de rapport (premier risque métier), langage très fort ('could materially and adversely affect'), tendance accrue avec l'IA générative mentionnée explicitement comme défi nouveau, catégorie technologie = poids fort pour éditeur logiciel.",
    "1": "Risque majeur positionné en début de rapport, langage très fort ('could materially suffer'), tendance accrue avec l'arrivée de nouveaux concurrents IA et cloud-native, catégorie concurrence = poids fort pour éditeur logiciel.",
    "2": "Risque majeur positionné en milieu de rapport, langage très fort ('reputational harm, liability and adverse business'), tendance nouvelle et accrue avec l'IA générative, catégorie réputation + régulation = poids très fort.",
    "3": "Risque majeur positionné en milieu de rapport, langage fort ('may result in inconsistencies', 'increase our compliance costs'), tendance nouvelle avec l'EU AI Act et réglementations fédérales US, catégorie régulation = poids fort.",
    "4": "Risque majeur positionné en milieu de rapport, langage fort ('intellectual property infringement claims', 'legal liability'), tendance nouvelle avec l'intégration croissante de modèles IA tiers, catégorie litige + régulation = poids fort.",
    "5": "Risque majeur positionné en milieu de rapport, langage fort ('reputational harm', 'reduced customer demand'), tendance accrue avec les critiques sur l'IA et les positions éthiques, catégorie réputation = poids fort.",
    "6": "Risque majeur positionné en milieu de rapport, langage fort ('may have an adverse effect', 'disruption of our ongoing business'), tendance stable mais avec exemple concret d'approbation réglementaire refusée, catégorie capital = poids moyen-fort.",
    "7": "Risque majeur positionné en fin de rapport (section 'Operation of Our Business'), langage modéré ('could harm our business'), tendance stable mais mentionnée comme défi continu, catégorie personne-clé = poids moyen."
  },
  "ai_positioning_fr": {
    "summary_fr": "Adobe intègre l'IA générative de manière stratégique dans son portefeuille de produits, positionnant l'IA comme élément central de sa proposition de valeur. La société déploie des modèles d'IA commercialement sûrs, des capacités conversationnelles et agents à travers ses solutions Digital Media et Digital Experience, avec un accent sur Firefly, Acrobat AI Assistant et GenStudio.",
    "evidence_fr": [
      {
        "text_fr": "MD&A FY2025: 'À l'ère de l'intelligence artificielle (IA), nous exploitons la puissance de l'IA dans nos solutions en réunissant nos modèles IA internes, sécurisés commercialement, et les meilleurs modèles IA de partenaires, les plus adaptés à la tâche'",
        "source": "MD&A FY2025: 'In the artificial intelligence (AI) era, we are harnessing the power of AI across our solutions by bringing together our commercially safe first-party and leading partner AI models best suited for the job'"
      },
      {
        "text_fr": "MD&A : 'L'innovation IA est profondément intégrée à nos solutions Digital Media, y compris via les fonctionnalités d'IA générative alimentées par Adobe Firefly disponibles dans nos applications phares de Creative Cloud, et via l'Assistant IA d'Acrobat'",
        "source": "MD&A: 'AI innovation is deeply infused into our Digital Media solutions, including through Adobe Firefly-powered generative AI features available across our Creative Cloud flagship apps, and through Acrobat AI Assistant'"
      },
      {
        "text_fr": "MD&A : 'En août 2025, nous avons lancé Acrobat Studio, qui réunit Adobe Acrobat, Adobe Express et des agents IA pour renforcer l’union de la productivité et de la créativité'",
        "source": "MD&A: 'In August 2025, we released Acrobat Studio, which brings together Adobe Acrobat, Adobe Express and AI agents to further unite productivity and creativity'"
      },
      {
        "text_fr": "MD&A : 'Les professionnels du marketing créatif exigent des solutions agiles et complètes avec des capacités IA commercialement sûres, et bénéficient d’investissements dans des flux de travail puissants et intégrés grâce à des offres telles qu’Adobe Firefly et Adobe GenStudio'",
        "source": "MD&A: 'Creative Marketing Professionals require agile and comprehensive solutions with commercially safe AI capabilities; and are benefiting from investments in powerful, integrated workflows through offerings such as Adobe Firefly and Adobe GenStudio'"
      },
      {
        "text_fr": "MD&A : 'À la base de nos solutions centrées sur le client se trouve notre stratégie IA et la plateforme IA d'Adobe'",
        "source": "MD&A: 'Underpinning our customer-focused solutions is our AI strategy and Adobe s AI platform'"
      },
      {
        "text_fr": "\"Nous développons des canaux de commercialisation numériques et d'entreprise différenciés ainsi que des flux de travail automatisés afin d'accroître la valeur de notre marque et notre portée mondiale\"",
        "source": "BUSINESS SECTION: 'We are scaling differentiated digital and enterprise routes to market and automated workflows to expand our brand value and global reach'"
      }
    ],
    "_translated_at": "2026-05-28T16:40:08",
    "_source": "scripts/translate-ai-positioning-fr.py"
  },
