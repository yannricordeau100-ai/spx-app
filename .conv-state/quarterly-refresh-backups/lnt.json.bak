 "risks_rationale_overrides": [
  {
   "title": "Demand Realization Risk",
   "category": "Operational",
   "score_rationale": "Ce risque est classé #4 sur 4 dans l'Item 1A, ce qui indique une priorité moindre (Position). L'intensité du langage est faible avec \"soumise à des conditions variables\", suggérant un impact incertain (Intensité). Il s'agit d'un risque nouveau par rapport à l'année précédente, ce qui augmente sa visibilité (Trend). Toutefois, sa catégorie opérationnelle a un poids modéré selon notre grille (Weight), ce qui explique le score intermédiaire de 3/5.",
   "_enriched_at": "2026-05-24T12:31:05.221754+00:00",
   "_enriched_by": "CONV-CONCEPTS sub-agent #24 Cerebras Qwen-3 235B"
  },
  {
   "title": "Regulatory Compliance",
   "category": "Regulation",
   "score_rationale": "Ce risque est classé #2 sur 4 dans l'Item 1A, indiquant une importance élevée (Position). L'intensité du langage est modérée avec une formulation factuelle sans alerte forte (Intensité). Le risque est stable par rapport à l'année précédente, sans aggravation ni atténuation (Trend). La catégorie Réglementaire porte un poids élevé en raison de l'exposition régulatoire et de la cybersécurité (Weight).",
   "_enriched_at": "2026-05-27T05:47:16.808493+00:00",
   "_enriched_by": "CONV-CONCEPTS sub-agent #24 Cerebras Qwen-3 235B"
  },
  {
   "title": "Third-Party Dependencies",
   "category": "Operational",
   "score_rationale": "Ce risque est positionné en troisième place sur quatre dans l'Item 1A du 10-K (1), indiquant une importance modérée. L'intensité du langage est faible, avec une formulation atténuée comme 'présente des risques opérationnels managés' (2). Par rapport à l'année précédente, le risque est stable, sans aggravation ni atténuation notable (3). Enfin, la catégorie 'opérational' porte un weight moyen selon notre grille de pondération (4).",
   "_enriched_at": "2026-05-27T05:47:19.587785+00:00",
   "_enriched_by": "CONV-CONCEPTS sub-agent #24 Cerebras Qwen-3 235B"
  }
 ],
