  "risks": [
    {
      "title": "Dépendance au budget gouvernement US (75% du CA)",
      "category": "Régulation",
      "severity": 3,
      "score_rationale": "\"Government programs must compete with programs managed by other government contractors and with other policy\" (début Item 1A, prudentiel standard) note 3/5.",
      "trend": "up",
      "summary": "75% du CA vient du gouvernement US. Un shutdown, un CR à long terme ou un reset de priorités budgétaires impacterait directement le rythme des commandes et paiements.",
      "score": 3
    },
    {
      "title": "Concurrence pour l'obtention de contrats compétitifs",
      "category": "Concurrence",
      "severity": 3,
      "score_rationale": "\"Government has increasingly relied on certain types of contracts that are subject to multiple competitive\" (début Item 1A, prudentiel standard) note 3/5.",
      "trend": "up",
      "summary": "L3Harris affronte primes historiques et nouveaux entrants tech. La perte d'awards concurrentiels érode le backlog et la trajectoire de croissance segments CS et IMS.",
      "score": 3
    },
    {
      "title": "Non-conformité contractuelle et debarment gouvernement US",
      "category": "Régulation",
      "severity": 3,
      "score_rationale": "\"privileges, which could have a material adverse effect on our business, financial condition, results of\" (milieu Item 1A, material adverse effect) note 3/5.",
      "trend": "stable",
      "summary": "Toute non-conformité aux règles fédérales, DFARS ou export peut entraîner amendes, dommages triples, voire suspension ou debarment de contrats fédéraux.",
      "score": 3
    },
    {
      "title": "Tarifs douaniers et perturbations de la chaîne d’approvisionnement",
      "category": "Opérationnel",
      "severity": 3,
      "score_rationale": "\"harm, any of which could materially and adversely affect our business, operational results, financial condition\" (milieu Item 1A, material adverse effect) note 3/5.",
      "trend": "up",
      "summary": "Les tarifs sur matériaux et composants renchérissent les inputs. L3Harris cherche exemptions et sources alternatives, mais un durcissement pèserait sur les marges programmes fixed-price.",
      "score": 3,
      "title_en": "Tarifs douaniers et perturbations supply chain"
    },
    {
      "title": "Audits DCAA et ajustements de coûts",
      "category": "Régulation",
      "severity": 3,
      "score_rationale": "\"Government oversight audits, which could result in adjustments to our contract costs.\" (début Item 1A, prudentiel standard) note 3/5.",
      "trend": "stable",
      "summary": "Les audits DCAA peuvent conduire à des refus de coûts, ajustements de contrats et remboursements. Toute réduction matérielle affecterait revenus et profits déjà comptabilisés.",
      "score": 3
    },
    {
      "title": "Exécution programmes fixed-price et EAC negatives",
      "category": "Opérationnel",
      "severity": 3,
      "score_rationale": "\"Fixed-price contracts, particularly for development programs, could subject us to losses from cost overruns or\" (début Item 1A, prudentiel standard) note 3/5.",
      "trend": "stable",
      "summary": "Les programmes fixed-price exposent L3Harris à des estimates at completion défavorables. IMS a déjà encaissé plusieurs EAC negatives significatives en 2025.",
      "score": 3
    },
    {
      "title": "Endettement post fusion et notation crédit",
      "category": "Financier",
      "severity": 2,
      "score_rationale": "\"or service our indebtedness may materially adversely affect our financial and operating activities or our\" (fin Item 1A, material adverse effect) note 2/5.",
      "trend": "down",
      "summary": "L'endettement post fusion reste substantiel. Un choc sur les cash-flows compliquerait le désendettement, le retour capital et la protection de la notation investment grade.",
      "score": 2
    }
  ],
