  "risks": [
    {
      "title": "Cyberattaque majeure et perturbation opérationnelle persistante",
      "category": "Cybersécurité",
      "severity": 4,
      "score": 4,
      "trend": "up",
      "summary": "Clorox a subi une cyberattaque significative en août 2023 qui a perturbé ses systèmes de prise de commandes, sa production et son ravitaillement des distributeurs pendant plusieurs trimestres. Le risque de récurrence et la dépendance à des systèmes ERP en cours de modernisation restent élevés.",
      "score_rationale": "Langage fort et cyberattaque d'août 2023 aux impacts réels, mais position médiane et risque désormais historique. Citation: \"cyberattacks, privacy breaches or data breaches could have a material adverse effect\". Position: milieu Item 1A."
    },
    {
      "title": "Concurrence des marques distributeurs et érosion des parts de marché",
      "category": "Concurrence",
      "severity": 3,
      "score": 3,
      "trend": "up",
      "summary": "Sur les sacs poubelle (Glad), litière (Fresh Step), eau de javel et nettoyants, les marques distributeurs gagnent du terrain à mesure que les consommateurs arbitrent en faveur du prix. Clorox a perdu des positions dans plusieurs catégories pendant la cyberattaque et peine à les reconquérir.",
      "score_rationale": "Position haute mais langage conditionnel standard, sans exposition chiffrée. Citation: \"could negatively impact net sales of the Company's higher-margin products\". Position: haut Item 1A."
    },
    {
      "title": "Coûts des matières premières et de la logistique",
      "category": "Approvisionnement",
      "severity": 3,
      "score": 3,
      "trend": "stable",
      "summary": "La résine plastique (HDPE, LDPE), la pâte à papier, l'huile de soja (Hidden Valley) et les coûts de transport restent volatils. La capacité à répercuter les hausses via le prix est limitée dans le contexte concurrentiel actuel.",
      "score_rationale": "Impact déjà matérialisé et intrants listés (résine, soja, emballage), mais sans chiffrage alarmant. Citation: \"have negatively impacted, and may continue to negatively impact, the Company's net earnings\". Position: milieu Item 1A."
    },
    {
      "title": "Litiges sur les ingrédients et obligations environnementales",
      "category": "Réglementaire",
      "severity": 2,
      "score": 2,
      "trend": "up",
      "summary": "Les class actions liées aux composés chimiques (PFAS, parabènes), les obligations EPR sur les emballages (Californie, Oregon, Colorado) et les régulations EPA sur les désinfectants augmentent les coûts de mise en conformité et le risque juridique.",
      "score_rationale": "Dernier tiers. Langage prudentiel générique, litiges et EPR communs au secteur, sans développement chiffré. Citation: \"legal proceedings could adversely affect the Company's financial condition and results of operations\". Position: bas Item 1A."
    },
    {
      "title": "Exposition aux marchés internationaux et FX (notamment Argentine)",
      "category": "Macro",
      "severity": 2,
      "score": 2,
      "trend": "stable",
      "summary": "Bien que la majorité du CA soit US, Clorox conserve des opérations en Amérique latine où l'hyperinflation argentine, les dévaluations et le contrôle des changes pèsent sur les résultats consolidés.",
      "score_rationale": "Dernier tiers. Exposition limitée (14% du CA international, Argentine cédée en 2024), langage conditionnel. Citation: \"foreign currency fluctuations, including devaluations, currency controls and inflation, which may adversely affect\". Position: milieu Item 1A."
    }
  ],
